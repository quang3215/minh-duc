---
import '../styles/global.css';
import settings from '../data/settings.json';
import DesktopHeader from '../components/shell/DesktopHeader.astro';
import MobileDrawer from '../components/shell/MobileDrawer.astro';
import ConversionFooter from '../components/shell/ConversionFooter.astro';
import FloatingStickyCTA from '../components/shell/FloatingStickyCTA.astro';
import MobileBottomNav from '../components/shell/MobileBottomNav.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: string | Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://thumuacapdonggiacao.com/img/banner/zalo-preview.jpg',
  ogType = 'website',
  schema,
  noindex = false,
  keywords,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://thumuacapdonggiacao.com';
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': 'https://thumuacapdonggiacao.com/#localbusiness',
      'name': 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      'alternateName': 'Thu Mua Cáp Đồng Giá Cao Đức Minh',
      'description': 'Đơn vị chuyên thu mua dây cáp đồng, thiết bị điện công trình, pin năng lượng mặt trời và phế liệu kim loại màu giá cao tận nơi tại TP.HCM, Bình Dương, Đồng Nai và toàn quốc.',
      'url': 'https://thumuacapdonggiacao.com',
      'logo': 'https://thumuacapdonggiacao.com/img/logo.svg',
      'image': 'https://thumuacapdonggiacao.com/img/banner/zalo-preview.jpg',
      'telephone': settings.hotline,
      'email': settings.email,
      'priceRange': '$$',
      'currenciesAccepted': 'VND',
      'paymentAccepted': 'Cash, Bank Transfer',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': '14 ấp 2, Đông Thạnh',
        'addressLocality': 'Hóc Môn',
        'addressRegion': 'TP. Hồ Chí Minh',
        'postalCode': '70000',
        'addressCountry': 'VN',
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': 10.910308,
        'longitude': 106.636344,
      },
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': [
            'Monday',
            'Tuesday',
            'Wednesday',
            'Thursday',
            'Friday',
            'Saturday',
            'Sunday',
          ],
          'opens': '06:00',
          'closes': '22:00',
        },
      ],
      'areaServed': [
        { '@type': 'City', 'name': 'Hồ Chí Minh' },
        { '@type': 'City', 'name': 'Bình Dương' },
        { '@type': 'City', 'name': 'Đồng Nai' },
        { '@type': 'City', 'name': 'Long An' },
        { '@type': 'Country', 'name': 'Việt Nam' },
      ],
      'sameAs': [
        'https://www.capdongbactrungnam.com/',
        settings.zaloLink,
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://thumuacapdonggiacao.com/#organization',
      'name': 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      'url': 'https://thumuacapdonggiacao.com',
      'logo': 'https://thumuacapdonggiacao.com/img/logo.svg',
      'contactPoint': {
        '@type': 'ContactPoint',
        'telephone': settings.hotline,
        'contactType': 'customer service',
        'areaServed': 'VN',
        'availableLanguage': ['Vietnamese', 'vi'],
      },
      'sameAs': [
        'https://www.capdongbactrungnam.com/',
        settings.zaloLink,
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://thumuacapdonggiacao.com/#website',
      'url': 'https://thumuacapdonggiacao.com',
      'name': 'Thu Mua Cáp Đồng Giá Cao Đức Minh',
      'description': 'Chuyên thu mua dây cáp điện 3 pha, cáp đồng công trình, pin năng lượng mặt trời giá cao toàn quốc',
      'publisher': {
        '@id': 'https://thumuacapdonggiacao.com/#organization',
      },
      'inLanguage': 'vi-VN',
    },
  ],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    {Astro.url.pathname === '/' && (
      <>
        <link rel="preload" as="image" href="/img/banner/banner-thu-mua-cap-dong-duc-minh-1_mobile.webp" media="(max-width: 768px)" />
        <link rel="preload" as="image" href="/img/banner/banner-thu-mua-cap-dong-duc-minh-1.webp" media="(min-width: 769px)" />
      </>
    )}
    <meta name="description" content={description} />
    <meta name="author" content="Công Ty Đức Minh" />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Công Ty Thu Mua Cáp Đồng Đức Minh" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#c90000" />

    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" /></noscript>

    <!-- Legacy Style Compatibility (fallback for pages before full migration) -->
    <link rel="stylesheet" href="/style.css?v=3" />

    <!-- Global Rich JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />

    <!-- Per-page Custom Schema JSON-LD -->
    {schema && (
      typeof schema === 'string'
        ? <script type="application/ld+json" set:html={schema} />
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Custom Tracking Scripts từ CMS Settings -->
    {settings.headScripts && <Fragment set:html={settings.headScripts} />}
  </head>

  <body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col font-sans selection:bg-red-500 selection:text-white">
    <!-- GTM noscript -->
    <noscript>
      <iframe title="Google Tag Manager"
        src="https://www.googletagmanager.com/ns.html?id=GTM-NW8X6RD3"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <!-- Eel UI Shell Header -->
    <DesktopHeader />

    <!-- Mobile Navigation Drawer -->
    <MobileDrawer />

    <!-- Main Page Content -->
    <main class="min-h-screen flex-1">
      <slot />
    </main>

    <!-- Eel UI Shell Footer -->
    <ConversionFooter />

    <!-- Floating Sticky Actions (Hotline, Zalo, Back-to-top) -->
    <FloatingStickyCTA />

    <!-- Mobile Bottom Fixed Navigation Bar -->
    <MobileBottomNav />

    <!-- Custom Body Scripts từ CMS Settings -->
    {settings.bodyScripts && <Fragment set:html={settings.bodyScripts} />}
  </body>
</html>
