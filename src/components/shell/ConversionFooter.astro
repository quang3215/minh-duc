---
import settings from '../../data/settings.json';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const services = [
  { label: 'Thu Mua Cáp Đồng & Thiết Bị Điện', href: '/thu-mua-cap-dong-thiet-bi-dien/' },
  { label: 'Thu Mua Pin Năng Lượng Mặt Trời', href: '/thu-mua-pin-nang-luong-mat-troi/' },
  { label: 'Thu Mua Phế Liệu Công Nghiệp', href: '/thu-mua-phe-lieu-cong-nghiep/' },
  { label: 'Thu Mua Nhôm Phế Liệu Giá Cao', href: '/thu-mua-nhom/' },
  { label: 'Thu Mua Inox 304, 201, 316', href: '/thu-mua-inox/' },
  { label: 'Xem Bảng Giá Phế Liệu Hôm Nay', href: '/bang-gia/' },
  { label: 'Quy Trình Thu Gom & Thanh Toán', href: '/quy-trinh/' },
];

const areas = [
  { label: 'TP. Hồ Chí Minh (15-30 phút)', href: '/thu-mua-cap-dong-tphcm/' },
  { label: 'Khu Vực Miền Nam (Bình Dương, Đồng Nai...)', href: '/khu-vuc-thu-mua/khu-vuc-mien-nam/' },
  { label: 'Khu Vực Toàn Quốc (Dự án lớn)', href: '/khu-vuc-thu-mua/khu-vuc-toan-quoc/' },
  { label: 'Khu Vực Miền Trung', href: '/khu-vuc-thu-mua/khu-vuc-mien-trung/' },
  { label: 'Khu Vực Miền Bắc', href: '/khu-vuc-thu-mua/khu-vuc-mien-bac/' },
];
---

<footer class="bg-slate-950 text-slate-300 relative overflow-hidden pt-16 pb-24 md:pb-12 border-t-4 border-brand-red">
  
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Conversion Banner Box -->
    <div class="bg-gradient-to-r from-red-950 via-slate-900 to-red-950 border border-red-800/60 rounded-3xl p-6 sm:p-8 md:p-10 mb-16 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-brand-red/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 relative z-10">
        <div class="text-center lg:text-left space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-red/20 border border-brand-red/40 text-red-300 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-red animate-ping"></span>
            Thu Mua Tận Nơi 24/7
          </div>
          <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight">
            Cần Bán Cáp Đồng, Dây Điện Cũ Hoặc Phế Liệu Giá Cao?
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Đức Minh có mặt sau 15–30 phút tại TP.HCM & các tỉnh lân cận. Khảo sát tận nơi, cân đo minh bạch, thanh toán liền tay 100% tiền mặt hoặc chuyển khoản!
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto shrink-0">
          <Button
            href={`tel:${settings.hotline}`}
            variant="phone"
            size="lg"
            class="shadow-glow-red hover:scale-105"
          >
            <svg slot="icon-left" class="w-5 h-5 animate-bounce" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
            </svg>
            <span>{settings.hotlineDisplay}</span>
          </Button>

          <Button
            href={settings.zaloLink}
            target="_blank"
            variant="zalo"
            size="lg"
            class="hover:scale-105"
          >
            <svg slot="icon-left" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Báo Giá Qua Zalo</span>
          </Button>
        </div>
      </div>
    </div>

    <!-- Main Footer 4 Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-16">
      
      <!-- Col 1: Về Công Ty Đức Minh -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-brand-red flex items-center justify-center p-1.5 shadow-md">
            <img
              src="/img/logo.svg"
              alt="Logo Thu Mua Cáp Đồng Đức Minh"
              width="40"
              height="40"
              class="w-full h-full object-contain"
            />
          </div>
          <div>
            <span class="font-black text-lg text-white tracking-tight block">
              CÁP ĐỒNG <span class="text-brand-red">ĐỨC MINH</span>
            </span>
            <span class="text-xs text-slate-400 font-medium">Đối tác thu mua tin cậy</span>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed">
          Đơn vị hàng đầu chuyên thu mua cáp đồng công trình, dây điện 3 pha, pin năng lượng mặt trời và phế liệu kim loại màu giá cao nhất thị trường.
        </p>

        <div class="pt-2 space-y-2 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Cân điện tử chuẩn xác, minh bạch
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Xe cẩu chuyên dụng bốc dỡ miễn phí
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Chiết khấu hoa hồng hấp dẫn cho người giới thiệu
          </div>
        </div>
      </div>

      <!-- Col 2: Dịch Vụ Thu Mua & Bảng Giá -->
      <div>
        <h4 class="text-white font-bold text-base mb-4 flex items-center gap-2">
          <span class="w-1.5 h-4 bg-brand-red rounded-full"></span>
          Dịch Vụ Thu Mua
        </h4>
        <ul class="space-y-2.5 text-sm">
          {
            services.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-slate-400 hover:text-white hover:translate-x-1 inline-flex items-center gap-1.5 transition-all duration-200"
                >
                  <span class="text-brand-red text-xs">›</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Thông Tin Liên Hệ & Kho Bãi -->
      <div>
        <h4 class="text-white font-bold text-base mb-4 flex items-center gap-2">
          <span class="w-1.5 h-4 bg-brand-red rounded-full"></span>
          Thông Tin Liên Hệ
        </h4>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <span class="text-brand-red text-base mt-0.5">📍</span>
            <div>
              <strong class="text-white block font-semibold">Trụ sở chính TP.HCM:</strong>
              <span>{settings.address}</span>
            </div>
          </li>

          <li class="flex items-start gap-2.5">
            <span class="text-brand-red text-base mt-0.5">🏢</span>
            <div>
              <strong class="text-white block font-semibold">Chi nhánh kho bãi:</strong>
              <span>Thuận An (Bình Dương) & KCN Biên Hòa (Đồng Nai)</span>
            </div>
          </li>

          <li class="flex items-center gap-2.5">
            <span class="text-brand-red text-base">📞</span>
            <div>
              <span class="text-slate-400">Hotline 24/7: </span>
              <a href={`tel:${settings.hotline}`} class="text-white font-bold hover:text-brand-red transition-colors">
                {settings.hotlineDisplay}
              </a>
            </div>
          </li>

          <li class="flex items-center gap-2.5">
            <span class="text-blue-400 text-base">💬</span>
            <div>
              <span class="text-slate-400">Zalo Báo Giá: </span>
              <a href={settings.zaloLink} target="_blank" rel="noopener noreferrer" class="text-white font-bold hover:text-blue-400 transition-colors">
                {settings.hotlineDisplay}
              </a>
            </div>
          </li>

          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 text-base">⏰</span>
            <div>
              <span class="text-slate-400">Giờ làm việc: </span>
              <span class="text-white font-medium">{settings.workingHours}</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Col 4: Bản Đồ Kho Hàng & Khu Vực -->
      <div>
        <h4 class="text-white font-bold text-base mb-4 flex items-center gap-2">
          <span class="w-1.5 h-4 bg-brand-red rounded-full"></span>
          Bản Đồ & Khu Vực
        </h4>
        
        <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-md bg-slate-900 aspect-video mb-3">
          <iframe
            title="Bản đồ chỉ đường đến Công ty Đức Minh"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15670.804260691722!2d106.636344!3d10.910308!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d70677247829%3A0xab4886d2a9b58705!2zQ8OUTkcgVFkgVEhVIE1VQSBQSOG6viBMSeG7hlUgxJDhu6hDIE1JTkg!5e0!3m2!1svi!2sus!4v1761935511970!5m2!1svi!2sus"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="flex flex-wrap gap-1.5">
          {
            areas.slice(0, 3).map((a) => (
              <a
                href={a.href}
                class="text-[11px] px-2 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800 transition-colors"
              >
                {a.label}
              </a>
            ))
          }
        </div>
      </div>

    </div>

    <!-- Bottom Legal & Ecosystem Attribution -->
    <div class="pt-8 border-t border-slate-800/80 text-xs text-slate-500 space-y-3">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-center md:text-left">
          © {new Date().getFullYear()} Bản quyền thuộc về <strong class="text-slate-300">Công Ty Thu Mua Cáp Đồng Đức Minh</strong>. All rights reserved.
        </p>

        <div class="flex items-center gap-4 flex-wrap justify-center">
          <a href="/chinh-sach-bao-mat/" class="hover:text-slate-300 transition-colors">Chính Sách Bảo Mật</a>
          <span>•</span>
          <a href="/bang-gia/" class="hover:text-slate-300 transition-colors">Bảng Giá</a>
          <span>•</span>
          <a href="/quy-trinh/" class="hover:text-slate-300 transition-colors">Quy Trình</a>
          <span>•</span>
          <a href="/lien-he/" class="hover:text-slate-300 transition-colors">Liên Hệ</a>
        </div>
      </div>

      <p class="text-[11px] text-slate-500 text-center md:text-left leading-relaxed">
        Thu Mua Cáp Đồng Giá Cao là thương hiệu chuyên trách về mảng kim loại màu, trực thuộc hệ sinh thái của Tổng công ty{' '}
        <a
          href="https://www.capdongbactrungnam.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-400 hover:underline font-semibold"
        >
          Cáp Điện Bắc Trung Nam
        </a>{' '}
        — Đơn vị hàng đầu về thu mua phế liệu công nghiệp và tháo dỡ nhà xưởng toàn quốc.
      </p>
    </div>

  </div>
</footer>
