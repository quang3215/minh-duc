---
import settings from '../../data/settings.json';

const pathname = Astro.url.pathname;
---

<!-- Mobile Fixed Bottom Navigation Bar -->
<div class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-white/95 backdrop-blur-lg border-t border-slate-200/90 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-2 py-1.5 transition-transform duration-300">
  <div class="grid grid-cols-4 items-center gap-1 max-w-md mx-auto">
    
    <!-- 1. Gọi Ngay -->
    <a
      href={`tel:${settings.hotline}`}
      class="flex flex-col items-center justify-center py-1 px-1 rounded-xl text-brand-red active:scale-95 transition-all group"
      aria-label="Gọi điện thoại hotline"
    >
      <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center group-active:bg-brand-red group-active:text-white transition-colors">
        <svg class="w-4 h-4 animate-bounce text-brand-red" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
        </svg>
      </div>
      <span class="text-[11px] font-bold mt-0.5 text-slate-800 leading-tight">Gọi Ngay</span>
    </a>

    <!-- 2. Chat Zalo -->
    <a
      href={settings.zaloLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-1 px-1 rounded-xl text-brand-zalo active:scale-95 transition-all group"
      aria-label="Chat báo giá Zalo"
    >
      <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center group-active:bg-brand-zalo group-active:text-white transition-colors">
        <span class="text-xs font-black text-brand-zalo">Zalo</span>
      </div>
      <span class="text-[11px] font-bold mt-0.5 text-slate-800 leading-tight">Chat Zalo</span>
    </a>

    <!-- 3. Bảng Giá -->
    <a
      href="/bang-gia/"
      class:list={[
        'flex flex-col items-center justify-center py-1 px-1 rounded-xl active:scale-95 transition-all group',
        pathname.startsWith('/bang-gia') ? 'text-amber-600 font-bold' : 'text-slate-600',
      ]}
      aria-label="Xem bảng giá phế liệu hôm nay"
    >
      <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center group-active:bg-amber-500 group-active:text-white transition-colors">
        <svg class="w-4 h-4 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
      </div>
      <span class="text-[11px] font-bold mt-0.5 text-slate-800 leading-tight">Bảng Giá</span>
    </a>

    <!-- 4. Báo Giá 5 Phút -->
    <a
      href={settings.zaloLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-1 px-1 rounded-xl text-brand-red active:scale-95 transition-all group"
      aria-label="Nhận báo giá nhanh trong 5 phút"
    >
      <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-red to-brand-red-light text-white flex items-center justify-center shadow-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
      </div>
      <span class="text-[11px] font-bold mt-0.5 text-brand-red leading-tight">Gửi Ảnh</span>
    </a>

  </div>
</div>
