---
import settings from '../../data/settings.json';
---

<!-- Floating Action Buttons (Hotline, Zalo & Back to Top) -->
<div class="fixed bottom-20 md:bottom-8 right-4 sm:right-6 z-40 flex flex-col items-end gap-3.5 select-none pointer-events-none">
  
  <!-- Back to Top Button -->
  <button
    type="button"
    id="btn-back-to-top"
    class="pointer-events-auto opacity-0 translate-y-3 invisible transition-all duration-300 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white shadow-soft-md flex items-center justify-center backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-slate-400"
    aria-label="Cuộn lên đầu trang"
    title="Lên đầu trang"
  >
    <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- Zalo Floating Button -->
  <a
    href={settings.zaloLink}
    target="_blank"
    rel="noopener noreferrer"
    class="pointer-events-auto group relative flex items-center"
    aria-label="Báo giá nhanh qua Zalo"
    title="Chat Zalo Báo Giá"
  >
    <!-- Tooltip Label (Desktop) -->
    <span class="hidden md:block mr-2.5 px-3 py-1 bg-white text-slate-800 text-xs font-bold rounded-full shadow-soft-md border border-slate-200 opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-2 group-hover:translate-x-0 whitespace-nowrap">
      💬 Gửi ảnh báo giá Zalo
    </span>

    <!-- Pulse Ring -->
    <div class="relative w-13 h-13 sm:w-14 sm:h-14">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-40"></span>
      <div class="relative w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-brand-zalo text-white shadow-soft-lg flex items-center justify-center hover:scale-110 active:scale-95 transition-transform duration-200 ring-2 ring-white">
        <svg class="w-7 h-7" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="24" fill="#0068FF"/>
          <path fill="#FFFFFF" d="M15 36V12.8l-1.2-.8C8.6 14.1 5 19.1 5 25c0 7.7 6.3 14 14 14h10c4.7 0 8.9-2.3 11.4-5.9V36H15z"/>
          <path fill="#0068FF" d="M29 11H19c-1.8 0-3.6.4-5.2 1C10.5 15.3 8 20.5 8 25c0 6.8.9 10.7 3.7 14.6.2.3.4.7.4 1 0 .8-.1 2.4-1.6 3.7-.2.1-.1.4.2.4.9 0 2.8 0 4.8-.9.6-.2 1.2-.2 1.7.1 2.3 1.2 6.1 1.4 9.8 1.4 4.7 0 9.3-1 12.4-2.9 2.6-2.1 3.6-4.9 3.6-7.9V25c0-7.7-6.3-14-14-14z"/>
          <path fill="#FFFFFF" d="M36.8 29c-2.1 0-3.8-1.7-3.8-3.8s1.7-3.8 3.8-3.8 3.8 1.7 3.8 3.8-1.7 3.8-3.8 3.8zm0-6c-1.2 0-2.3 1-2.3 2.2s1 2.3 2.3 2.3 2.2-1 2.2-2.3-1-2.2-2.2-2.2zM31.5 29h-1c-.3 0-.5-.2-.5-.5V20h1.5v9zM27 21.8v.5c-.6-.5-1.4-.8-2.3-.8-2.1 0-3.8 1.7-3.8 3.8s1.7 3.8 3.8 3.8c.8 0 1.6-.3 2.3-.8v.5c0 .3.2.5.5.5h1V21.8H27zm-2.2 5.7c-1.2 0-2.3-1-2.3-2.2s1-2.3 2.3-2.3 2.2 1 2.2 2.3-1 2.2-2.2 2.2zM21.2 20h-8v1.5h5.3L13 28h.1c-.2.2-.3.5-.3.8V29h7.5c.3 0 .5-.2.5-.5v-1h-5.3L21 21h-.1c-.2-.2-.3-.5-.3-.8V20z"/>
        </svg>
      </div>
    </div>
  </a>

  <!-- Hotline Floating Call Button -->
  <a
    href={`tel:${settings.hotline}`}
    class="pointer-events-auto group relative flex items-center"
    aria-label="Gọi điện trực tiếp đến Hotline Đức Minh"
    title="Gọi ngay: 0936.350.118"
  >
    <!-- Tooltip Label (Desktop) -->
    <span class="hidden md:block mr-2.5 px-3 py-1 bg-brand-red text-white text-xs font-bold rounded-full shadow-soft-md opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-2 group-hover:translate-x-0 whitespace-nowrap">
      📞 Hotline: {settings.hotlineDisplay}
    </span>

    <!-- Pulse Ring -->
    <div class="relative w-13 h-13 sm:w-14 sm:h-14">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-red opacity-60"></span>
      <div class="relative w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-gradient-to-br from-brand-red to-brand-red-dark text-white shadow-glow-red flex items-center justify-center hover:scale-110 active:scale-95 transition-transform duration-200 ring-2 ring-white">
        <svg class="w-6 h-6 animate-bounce" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
        </svg>
      </div>
    </div>
  </a>

</div>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('btn-back-to-top');
    if (!btn) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'translate-y-3', 'invisible');
        btn.classList.add('opacity-100', 'translate-y-0', 'visible');
      } else {
        btn.classList.remove('opacity-100', 'translate-y-0', 'visible');
        btn.classList.add('opacity-0', 'translate-y-3', 'invisible');
      }
    }, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
