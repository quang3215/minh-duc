---
import settings from '../../data/settings.json';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

export interface Props {
  badgeText?: string;
  title?: string;
  highlightTitle?: string;
  titleSuffix?: string;
  subtitle?: string;
  imageSrc?: string;
  mobileImageSrc?: string;
  imageAlt?: string;
  class?: string;
}

const {
  badgeText = '🔥 THU MUA TẬN NƠI 24/7 • TP.HCM, BÌNH DƯƠNG, ĐỒNG NAI & TOÀN QUỐC',
  title = 'Thu Mua Cáp Đồng & Phế Liệu Điện',
  highlightTitle = 'Giá Cao Hơn 30%',
  titleSuffix = 'Tận Nơi',
  subtitle = 'Công ty Đức Minh chuyên thu mua trọn gói cáp đồng công trình, dây điện 3 pha cũ, pin năng lượng mặt trời, tủ điện và phế liệu nhà xưởng. Khảo sát nhanh 15-30 phút, xe cẩu bốc xếp miễn phí, cân điện tử chuẩn xác, thanh toán 100% tại chỗ!',
  imageSrc = '/img/banner/banner-thu-mua-cap-dong-duc-minh-1.webp',
  mobileImageSrc = '/img/banner/banner-thu-mua-cap-dong-duc-minh-1_mobile.webp',
  imageAlt = 'Thu mua cáp đồng phế liệu và thiết bị điện công nghiệp giá cao - Công ty Đức Minh',
  class: className = '',
} = Astro.props;

const trustStats = [
  { value: '10+ Năm', label: 'Uy tín hàng đầu' },
  { value: '500+ Tấn', label: 'Năng lực xử lý/tháng' },
  { value: '15-30 Phút', label: 'Có mặt khảo sát' },
  { value: '100%', label: 'Thanh toán tại chỗ' },
];
---

<section class:list={['relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-10 pb-16 lg:pt-14 lg:pb-24 border-b border-slate-800', className]}>
  <!-- Background glow effects -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none translate-y-1/2"></div>
  <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & High-Conversion CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Urgent Live Banner -->
        <div class="mb-5 inline-block">
          <Badge variant="gold" size="md" pulsingDot class="bg-amber-400/10 text-amber-300 border-amber-400/30 backdrop-blur-sm">
            {badgeText}
          </Badge>
        </div>

        <!-- H1 Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black tracking-tight leading-[1.15] text-white">
          {title}{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-red-400 to-brand-red">
            {highlightTitle}
          </span>{' '}
          {titleSuffix}
        </h1>

        <!-- Subtitle Paragraph -->
        <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          {subtitle}
        </p>

        <!-- Social Proof Rating Pill -->
        <div class="mt-6 flex flex-wrap items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-4 py-2.5 backdrop-blur-md">
          <div class="flex text-amber-400 text-base tracking-tighter" aria-label="Đánh giá 5 sao">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="h-4 w-px bg-white/20"></div>
          <span class="text-xs sm:text-sm font-semibold text-slate-200">
            <strong class="text-white">4.9 / 5.0</strong> từ 1.250+ nhà thầu & doanh nghiệp
          </span>
          <span class="hidden sm:inline-flex items-center gap-1 text-[11px] font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full">
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Đã xác thực
          </span>
        </div>

        <!-- Dual CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto">
          <Button
            href={`tel:${settings.hotline}`}
            variant="phone"
            size="lg"
            pulse
            class="shadow-glow-red font-extrabold text-base tracking-wide"
          >
            <svg slot="icon-left" class="w-5 h-5 animate-bounce" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
            </svg>
            <span>GỌI HOTLINE: {settings.hotlineDisplay}</span>
          </Button>

          <Button
            href={settings.zaloLink}
            target="_blank"
            variant="zalo"
            size="lg"
            class="font-bold text-base hover:scale-105"
          >
            <span slot="icon-left" class="w-5 h-5 rounded-full bg-white text-brand-zalo flex items-center justify-center font-black text-xs">
              Z
            </span>
            <span>Gửi Ảnh Báo Giá Zalo (5 Phút)</span>
          </Button>
        </div>

        <!-- Commission incentive hint -->
        <div class="mt-4 flex items-center gap-2 text-xs sm:text-sm text-amber-300/90 font-medium">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-400/20 text-amber-300 font-bold text-xs">
            ✓
          </span>
          <span>Hoa hồng cao cho người giới thiệu • Bảo mật thông tin tuyệt đối</span>
        </div>

      </div>

      <!-- Right Column: Hero Visual & Floating Trust Overlays -->
      <div class="lg:col-span-5 relative mt-4 lg:mt-0">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Outer gradient border wrapper -->
          <div class="relative rounded-3xl p-1.5 bg-gradient-to-tr from-brand-red via-amber-500/50 to-slate-700 shadow-2xl overflow-hidden group">
            <div class="relative rounded-2xl overflow-hidden bg-slate-950 aspect-[4/3] sm:aspect-[16/11]">
              <picture>
                <source media="(max-width: 768px)" srcset={mobileImageSrc} />
                <img
                  src={imageSrc}
                  alt={imageAlt}
                  width="1920"
                  height="1080"
                  fetchpriority="high"
                  class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

              <!-- Inner Badge on Image -->
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between bg-slate-900/90 backdrop-blur-md border border-white/10 rounded-xl px-4 py-2.5">
                <div class="flex items-center gap-2.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-xs font-bold text-slate-200">Đội Xe Cẩu & Bốc Xếp Sẵn Sàng</span>
                </div>
                <span class="text-[11px] font-semibold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-400/20">
                  Miễn Phí 100%
                </span>
              </div>
            </div>
          </div>

          <!-- Floating Pill 1: Top Right (Báo giá 5 phút) -->
          <div class="absolute -top-4 -right-2 sm:-right-4 bg-white text-slate-900 rounded-2xl p-3 shadow-soft-lg border border-slate-200/90 flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 font-black text-lg">
              ⚡
            </div>
            <div>
              <p class="text-xs font-extrabold text-slate-900 leading-tight">Báo Giá Nhanh</p>
              <p class="text-[10px] text-slate-500 font-medium">Chỉ sau 5 phút qua Zalo</p>
            </div>
          </div>

          <!-- Floating Pill 2: Bottom Left (Cân điện tử chuẩn xác) -->
          <div class="absolute -bottom-5 -left-2 sm:-left-4 bg-slate-900/95 text-white rounded-2xl p-3 shadow-soft-lg border border-slate-700/80 backdrop-blur-md flex items-center gap-2.5 hidden sm:flex">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-black text-base">
              ⚖️
            </div>
            <div>
              <p class="text-xs font-extrabold text-white leading-tight">Cân Đo Chuẩn Xác</p>
              <p class="text-[10px] text-slate-400 font-medium">Cân điện tử có tem kiểm định</p>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Bottom Metric Trust Cards Grid -->
    <div class="mt-14 lg:mt-18 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 lg:gap-6 pt-10 border-t border-slate-800/80">
      {trustStats.map((stat) => (
        <div class="bg-white/5 hover:bg-white/10 transition-colors border border-white/10 rounded-2xl p-4 sm:p-5 backdrop-blur-sm flex flex-col">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200 tracking-tight">
            {stat.value}
          </span>
          <span class="mt-1 text-xs sm:text-sm font-medium text-slate-300">
            {stat.label}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>
