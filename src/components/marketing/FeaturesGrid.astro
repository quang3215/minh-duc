---
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';

export interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  badge = 'VÌ SAO CHỌN ĐỨC MINH',
  title = '6 Cam Kết Vàng Giúp Đối Tác Yên Tâm Tuyệt Đối',
  subtitle = 'Với hơn 10 năm uy tín trong ngành phế liệu kim loại màu và thiết bị điện, Đức Minh tự hào là đối tác chiến lược tin cậy của hơn 1.250+ nhà thầu & doanh nghiệp.',
  class: className = '',
} = Astro.props;

const features = [
  {
    icon: '💰',
    badge: 'Giá Tốt Nhất',
    badgeVariant: 'danger' as const,
    title: 'Giá Cao Hơn 20 – 30% Thị Trường',
    desc: 'Thu mua trực tiếp và tái chế khép kín, không qua trung gian giúp định giá cáp đồng, pin solar và phế liệu ở mức cao nhất.',
    gradient: 'from-red-500/10 to-red-500/5',
    iconBg: 'bg-red-100 text-brand-red',
  },
  {
    icon: '⚖️',
    badge: 'Minh Bạch 100%',
    badgeVariant: 'success' as const,
    title: 'Cân Đo Điện Tử Chuẩn Xác',
    desc: 'Hệ thống cân điện tử hiện đại có tem kiểm định của Chi cục Đo lường. Khách hàng trực tiếp đối chiếu và giám sát số ký.',
    gradient: 'from-emerald-500/10 to-emerald-500/5',
    iconBg: 'bg-emerald-100 text-emerald-700',
  },
  {
    icon: '🚛',
    badge: 'Miễn Phí 100%',
    badgeVariant: 'info' as const,
    title: 'Xe Cẩu & Bốc Xếp Tận Nơi',
    desc: 'Đội xe tải cẩu chuyên dụng từ 1.5T – 15T tự bốc xếp và vận chuyển. Vệ sinh, dọn dẹp trả lại mặt bằng kho bãi sạch sẽ sau thu gom.',
    gradient: 'from-blue-500/10 to-blue-500/5',
    iconBg: 'bg-blue-100 text-blue-700',
  },
  {
    icon: '💵',
    badge: 'Tức Thì',
    badgeVariant: 'gold' as const,
    title: 'Thanh Toán 100% Liền Tay',
    desc: 'Quyết toán 1 lần duy nhất ngay sau khi cân xong. Nhận tiền mặt trực tiếp tại chỗ hoặc chuyển khoản Internet Banking tức thì.',
    gradient: 'from-amber-500/10 to-amber-500/5',
    iconBg: 'bg-amber-100 text-amber-800',
  },
  {
    icon: '🎁',
    badge: 'Hấp Dẫn',
    badgeVariant: 'primary' as const,
    title: 'Hoa Hồng Cao & Bảo Mật',
    desc: 'Chính sách chiết khấu hoa hồng cực cao cho anh em kỹ sư, thủ kho, người giới thiệu nguồn hàng. Bảo mật thông tin tuyệt đối.',
    gradient: 'from-rose-500/10 to-rose-500/5',
    iconBg: 'bg-rose-100 text-rose-700',
  },
  {
    icon: '⚡',
    badge: 'Thần Tốc',
    badgeVariant: 'danger' as const,
    title: 'Khảo Sát Tận Nơi 15 – 30 Phút',
    desc: 'Có mặt ngay sau 15-30 phút tại TP.HCM, Bình Dương, Đồng Nai, Long An. Thu mua toàn quốc 24/7 kể cả ngày nghỉ và lễ.',
    gradient: 'from-orange-500/10 to-orange-500/5',
    iconBg: 'bg-orange-100 text-orange-700',
  },
];
---

<section class:list={['py-16 lg:py-24 bg-white relative', className]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      <Badge variant="primary" size="md" dot class="mb-3">
        {badge}
      </Badge>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- 6 Features Grid (1 / 2 / 3 cols) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {features.map((feature) => (
        <Card
          variant="interactive"
          padding="lg"
          class:list={[
            'h-full flex flex-col justify-between relative overflow-hidden bg-gradient-to-br',
            feature.gradient,
          ]}
        >
          <div>
            <!-- Top Icon & Badge Row -->
            <div class="flex items-center justify-between gap-3 mb-5">
              <div class:list={['w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow-soft-sm group-hover:scale-110 transition-transform duration-300', feature.iconBg]}>
                {feature.icon}
              </div>
              <Badge variant={feature.badgeVariant} size="sm">
                {feature.badge}
              </Badge>
            </div>

            <!-- Title & Description -->
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-brand-red transition-colors leading-snug">
              {feature.title}
            </h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              {feature.desc}
            </p>
          </div>

          <!-- Bottom check marker -->
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-xs font-semibold text-slate-500 group-hover:text-brand-red transition-colors">
            <span class="w-4 h-4 rounded-full bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-[10px]">
              ✓
            </span>
            <span>Cam kết thực hiện chuẩn xác</span>
          </div>
        </Card>
      ))}
    </div>

  </div>
</section>
