---
import settings from '../../data/settings.json';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';

export interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  showAllLink?: boolean;
  class?: string;
}

const {
  badge = 'BẢNG GIÁ HÔM NAY',
  title = 'Bảng Giá Thu Mua Cáp Đồng & Phế Liệu Mới Nhất',
  subtitle = 'Cam kết giá thu mua cao hơn thị trường 20-30%. Bảng giá cập nhật theo biến động giá kim loại thế giới & trong nước hôm nay.',
  showAllLink = true,
  class: className = '',
} = Astro.props;

const priceCategories = [
  {
    category: 'Cáp Đồng & Dây Điện',
    badge: 'Thu Mua Nhiều',
    badgeVariant: 'danger' as const,
    highlight: true,
    items: [
      { name: 'Đồng cáp loại 1 (Cadivi, trung thế, cáp đặc)', price: '250.000 – 350.000 đ/kg', unit: 'đ/kg', hot: true },
      { name: 'Đồng đỏ loại 2 (ruột trần, mô tơ, biến áp)', price: '225.000 – 280.000 đ/kg', unit: 'đ/kg' },
      { name: 'Đồng vàng / Đồng thau loại 3', price: '130.000 – 180.000 đ/kg', unit: 'đ/kg' },
      { name: 'Đồng cháy, dây điện vụn thải công trình', price: '100.000 – 160.000 đ/kg', unit: 'đ/kg' },
    ],
  },
  {
    category: 'Vật Tư Năng Lượng Mặt Trời',
    badge: 'Chuyên Sâu',
    badgeVariant: 'gold' as const,
    highlight: false,
    items: [
      { name: 'Tấm pin Solar (Mono, Poly cũ hỏng, tồn kho)', price: 'Liên Hệ Theo Wp / Chiếc', unit: '', hot: true },
      { name: 'Dây cáp điện DC Solar 4.0 – 6.0mm', price: '105.000 – 255.000 đ/kg', unit: 'đ/kg' },
      { name: 'Inverter (Biến tần) hòa lưới cũ', price: 'Báo Giá Theo Công Suất', unit: '' },
      { name: 'Khung giàn, thanh ray, kẹp pin (Nhôm, Sắt)', price: '25.000 – 65.000 đ/kg', unit: 'đ/kg' },
    ],
  },
  {
    category: 'Phế Liệu Nhôm & Inox',
    badge: 'Giá Cao',
    badgeVariant: 'info' as const,
    highlight: false,
    items: [
      { name: 'Nhôm đặc loại 1 (nhôm đà, nhôm khối)', price: '45.000 – 65.000 đ/kg', unit: 'đ/kg', hot: true },
      { name: 'Nhôm định hình, khung nhôm cửa Xingfa', price: '40.000 – 55.000 đ/kg', unit: 'đ/kg' },
      { name: 'Inox loại 1 (Inox 304, Inox 316)', price: '25.000 – 55.000 đ/kg', unit: 'đ/kg' },
      { name: 'Inox loại 2 (Inox 201, 430, ba zớ)', price: '12.000 – 25.000 đ/kg', unit: 'đ/kg' },
    ],
  },
  {
    category: 'Thiết Bị Điện & Nhà Xưởng',
    badge: 'Trọn Gói',
    badgeVariant: 'success' as const,
    highlight: false,
    items: [
      { name: 'Tủ điện công nghiệp & thiết bị đóng cắt', price: 'Khảo Sát Báo Giá Dự Án', unit: '', hot: true },
      { name: 'Motor điện (Mô tơ) 1 pha, 3 pha cũ', price: 'Định Giá Theo Tải Trọng', unit: '' },
      { name: 'Máy biến áp, trạm biến áp thanh lý', price: 'Báo Giá Tận Nơi Tốt Nhất', unit: '' },
      { name: 'Phá dỡ hệ thống điện & dây chuyền cũ', price: 'Thu Mua Trọn Gói Tận Nơi', unit: '' },
    ],
  },
];
---

<section class:list={['py-16 lg:py-24 bg-slate-50 relative', className]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      <Badge variant="danger" size="md" dot class="mb-3">
        {badge}
      </Badge>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Pricing 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {priceCategories.map((cat) => (
        <Card
          variant={cat.highlight ? 'bordered' : 'elevated'}
          padding="none"
          class:list={[
            'flex flex-col h-full relative group transition-all duration-300',
            cat.highlight ? 'border-brand-red/40 ring-2 ring-brand-red/10 shadow-soft-md' : 'hover:border-slate-300',
          ]}
        >
          {cat.highlight && (
            <div class="bg-gradient-to-r from-brand-red to-brand-red-dark text-white text-[11px] font-bold uppercase tracking-wider py-1 text-center">
              ⭐ Danh Mục Được Thu Mua Nhiều Nhất
            </div>
          )}

          <!-- Card Header -->
          <div class="p-5 sm:p-6 border-b border-slate-100 bg-gradient-to-b from-slate-50/80 to-white">
            <div class="flex items-center justify-between gap-2 mb-2">
              <h3 class="text-lg font-extrabold text-slate-900 leading-snug">
                {cat.category}
              </h3>
              <Badge variant={cat.badgeVariant} size="sm">
                {cat.badge}
              </Badge>
            </div>
            <p class="text-xs text-slate-500 font-medium">
              Cân điện tử chính xác • Thu gom tận nơi
            </p>
          </div>

          <!-- Price Items List -->
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
            <ul class="space-y-3.5">
              {cat.items.map((item) => (
                <li class="pb-3 border-b border-slate-100 last:border-0 last:pb-0">
                  <div class="flex items-start justify-between gap-2">
                    <span class="text-xs sm:text-sm font-semibold text-slate-700 leading-tight">
                      {item.name}
                    </span>
                    {item.hot && (
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-100 text-brand-red shrink-0">
                        HOT
                      </span>
                    )}
                  </div>
                  <div class="mt-1.5 flex items-baseline justify-between">
                    <span class="text-xs text-slate-500">Đơn giá:</span>
                    <span class="text-sm sm:text-base font-extrabold text-brand-red">
                      {item.price}
                    </span>
                  </div>
                </li>
              ))}
            </ul>

            <!-- Quick Card CTA -->
            <div class="pt-4 mt-auto">
              <Button
                href={settings.zaloLink}
                target="_blank"
                variant={cat.highlight ? 'primary' : 'outline'}
                size="sm"
                fullWidth
                class="text-xs font-bold"
              >
                <span>Báo Giá Nhóm Này</span>
                <span slot="icon-right">→</span>
              </Button>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <!-- Pricing Estimation & Hotline Notice Box -->
    <div class="mt-12 bg-gradient-to-r from-red-50 via-amber-50 to-orange-50 rounded-2xl p-6 sm:p-8 border border-red-100 shadow-soft-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-red text-white flex items-center justify-center text-2xl shrink-0 shadow-soft-sm">
          💡
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold text-slate-900">
            Bạn có số lượng lớn công trình hoặc cần thẩm định trực tiếp?
          </h4>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
            Lô hàng trên <strong>500kg</strong> hoặc công trình giải phóng mặt bằng sẽ có <strong>đơn giá ưu đãi cao nhất</strong> + xe cẩu miễn phí và hoa hồng giới thiệu sòng phẳng.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0 w-full md:w-auto">
        <Button
          href={`tel:${settings.hotline}`}
          variant="phone"
          size="md"
          class="flex-1 md:flex-initial font-bold shadow-soft-sm"
        >
          <svg slot="icon-left" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
          </svg>
          <span>{settings.hotlineDisplay}</span>
        </Button>

        {showAllLink && (
          <Button
            href="/bang-gia/"
            variant="secondary"
            size="md"
            class="flex-1 md:flex-initial font-semibold"
          >
            <span>Xem Bảng Giá Chi Tiết</span>
            <span slot="icon-right">→</span>
          </Button>
        )}
      </div>
    </div>

  </div>
</section>
