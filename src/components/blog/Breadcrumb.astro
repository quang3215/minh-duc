---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://thumuacapdonggiacao.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': items.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.label,
    'item': item.href
      ? (item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`)
      : undefined,
  })),
};
---

<nav aria-label="Breadcrumb" class:list={['py-3 text-xs sm:text-sm text-slate-500 font-medium', className]}>
  <ol class="flex items-center flex-wrap gap-1.5 sm:gap-2 list-none p-0 m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      const isFirst = index === 0;

      return (
        <li
          class="flex items-center gap-1.5 sm:gap-2"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          {index > 0 && (
            <svg
              class="w-3.5 h-3.5 text-slate-400 shrink-0 select-none"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          )}

          {item.href && !isLast ? (
            <a
              href={item.href}
              itemprop="item"
              class="text-slate-600 hover:text-brand-red font-medium transition-colors flex items-center gap-1.5 hover:underline underline-offset-2"
            >
              {isFirst && (
                <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                </svg>
              )}
              <span itemprop="name">{item.label}</span>
            </a>
          ) : (
            <span
              class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-md"
              itemprop="name"
              aria-current={isLast ? 'page' : undefined}
            >
              {item.label}
            </span>
          )}
          <meta itemprop="position" content={String(index + 1)} />
        </li>
      );
    })}
  </ol>
  
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</nav>
