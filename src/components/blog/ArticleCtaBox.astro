---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import settings from '../../data/settings.json';

export interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = 'Bạn Có Nguồn Dây Cáp Đồng Phế Liệu Cần Thanh Lý?',
  subtitle = 'Gửi ảnh hoặc video qua Zalo 0936.350.118 để nhận báo giá cao nhất trong 5 phút! Chúng tôi có đội xe cẩu đến tận nơi bốc xếp, dọn sạch kho bãi và thanh toán 100% tại chỗ.',
  class: className = '',
} = Astro.props;

const hotline = settings.hotline || '0936350118';
const hotlineDisplay = settings.hotlineDisplay || '0936.350.118';
const zaloLink = settings.zaloLink || 'https://zalo.me/0936350118';
---

<section
  class:list={[
    'relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-950 to-red-950 text-white p-6 sm:p-8 lg:p-10 shadow-soft-lg border border-red-900/40 my-10',
    className,
  ]}
>
  <!-- Background Decorative Accents -->
  <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-brand-red/20 blur-3xl pointer-events-none" />
  <div class="absolute -left-20 -top-20 w-80 h-80 rounded-full bg-amber-500/10 blur-3xl pointer-events-none" />

  <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
    <!-- Left Copy Area -->
    <div class="max-w-2xl text-center lg:text-left">
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 mb-3">
        <Badge variant="gold" size="sm" dot>
          ⚡ BÁO GIÁ SIÊU TỐC 5 PHÚT
        </Badge>
        <span class="text-xs text-amber-300 font-semibold bg-amber-950/60 border border-amber-500/30 px-2.5 py-0.5 rounded-full">
          Giá Cao Hơn Thị Trường 15-30%
        </span>
      </div>

      <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white leading-snug tracking-tight">
        {title}
      </h3>

      <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
        {subtitle}
      </p>

      <!-- Trust Pillars Badges -->
      <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-4 border-t border-white/10">
        <div class="flex items-center gap-1.5 text-xs text-slate-200">
          <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
          <span>Xe cẩu tận nơi 0đ</span>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-slate-200">
          <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
          <span>Cân điện tử chuẩn 100%</span>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-slate-200">
          <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">✓</span>
          <span>Thanh toán ngay tức thì</span>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-slate-200">
          <span class="w-4 h-4 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center text-[10px] font-bold">★</span>
          <span>Hoa hồng cao giới thiệu</span>
        </div>
      </div>
    </div>

    <!-- Right Actions / CTA Buttons -->
    <div class="flex flex-col sm:flex-row lg:flex-col gap-3.5 w-full sm:w-auto shrink-0 justify-center">
      <Button
        href={zaloLink}
        variant="zalo"
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full justify-center shadow-lg shadow-blue-500/30 text-center font-bold"
      >
        <svg slot="icon-left" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.35 5L2 22l5.18-1.31C8.61 21.49 10.26 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.54 0-2.98-.44-4.21-1.2l-.3-.19-3.09.78.82-2.99-.2-.32C4.34 14.89 3.9 13.5 3.9 12c0-4.47 3.63-8.1 8.1-8.1 4.47 0 8.1 3.63 8.1 8.1 0 4.47-3.63 8.1-8.1 8.1z"/>
        </svg>
        <span>Gửi Ảnh Báo Giá Zalo</span>
      </Button>

      <Button
        href={`tel:${hotline}`}
        variant="phone"
        size="lg"
        class="w-full justify-center shadow-lg shadow-red-600/30 text-center font-bold"
      >
        <svg slot="icon-left" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
        </svg>
        <span>Gọi Ngay: {hotlineDisplay}</span>
      </Button>

      <p class="text-center text-[11px] text-slate-400 font-normal mt-1">
        Phục vụ 24/7 • Kể cả Thứ 7, CN & Ngày Lễ
      </p>
    </div>
  </div>
</section>
