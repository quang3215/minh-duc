---
export interface Props {
  variant?: 'primary' | 'gold' | 'success' | 'danger' | 'info' | 'outline' | 'slate';
  size?: 'sm' | 'md' | 'lg';
  dot?: boolean;
  pulsingDot?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  dot = false,
  pulsingDot = false,
  class: className = '',
  ...rest
} = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'bg-red-50 text-brand-red border-red-200/80',
  gold: 'bg-amber-50 text-amber-800 border-amber-200/80',
  success: 'bg-emerald-50 text-emerald-800 border-emerald-200/80',
  danger: 'bg-rose-50 text-rose-700 border-rose-200/80',
  info: 'bg-blue-50 text-blue-800 border-blue-200/80',
  outline: 'bg-white/80 text-slate-700 border-slate-300',
  slate: 'bg-slate-100 text-slate-800 border-slate-200',
};

const dotColors: Record<string, string> = {
  primary: 'bg-brand-red',
  gold: 'bg-amber-500',
  success: 'bg-emerald-500',
  danger: 'bg-rose-500',
  info: 'bg-blue-500',
  outline: 'bg-slate-500',
  slate: 'bg-slate-600',
};

const sizeClasses: Record<string, string> = {
  sm: 'text-xs px-2.5 py-0.5 rounded-full font-medium gap-1',
  md: 'text-xs sm:text-sm px-3 py-1 rounded-full font-semibold gap-1.5',
  lg: 'text-sm sm:text-base px-4 py-1.5 rounded-full font-bold gap-2',
};

const selectedVariant = variantClasses[variant] || variantClasses.primary;
const selectedSize = sizeClasses[size] || sizeClasses.md;
const dotColor = dotColors[variant] || dotColors.primary;
---

<span
  class:list={[
    'inline-flex items-center border transition-colors',
    selectedVariant,
    selectedSize,
    className,
  ]}
  {...rest}
>
  {(dot || pulsingDot) && (
    <span class="relative flex h-2 w-2">
      {pulsingDot && (
        <span
          class:list={[
            'animate-ping absolute inline-flex h-full w-full rounded-full opacity-75',
            dotColor,
          ]}
        />
      )}
      <span class:list={['relative inline-flex rounded-full h-2 w-2', dotColor]} />
    </span>
  )}
  <slot />
</span>
