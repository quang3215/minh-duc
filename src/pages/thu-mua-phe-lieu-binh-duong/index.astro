---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      name: 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      image: 'https://thumuacapdonggiacao.com/img/logo.svg',
      url: 'https://thumuacapdonggiacao.com/',
      telephone: '+84936350118',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '14 ấp 2, Đông Thạnh',
        addressLocality: 'Bình Dương',
        addressRegion: 'TP. HCM',
        addressCountry: 'VN',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang Chủ',
          item: 'https://thumuacapdonggiacao.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Thu Mua Phế Liệu Bình Dương',
          item: 'https://thumuacapdonggiacao.com/thu-mua-phe-lieu-binh-duong/',
        },
      ],
    },
  ],
});

const priceList = [
  { type: 'Cáp đồng, đồng đỏ, dây cáp điện 3 pha công trình', price: '280.000 – 410.000 đ/kg' },
  { type: 'Phế liệu nhôm (Nhôm đặc, nhôm đà, nhôm định hình)', price: '45.000 – 85.000 đ/kg' },
  { type: 'Phế liệu Inox (Inox 304, Inox 201 bồn bể)', price: '25.000 – 75.000 đ/kg' },
  { type: 'Sắt phế liệu (Sắt đặc, sắt vụn, kết cấu nhà xưởng)', price: '10.000 – 25.000 đ/kg' },
  { type: 'Thiết bị, máy móc dây chuyền nhà xưởng', price: 'Báo giá sau khảo sát' },
];

const areas = [
  { title: 'Thành Phố & Thị Xã', list: 'TP. Thủ Dầu Một, TP. Dĩ An, TP. Thuận An, TP. Tân Uyên, TP. Bến Cát, Huyện Bàu Bàng, Bắc Tân Uyên, Dầu Tiếng, Phú Giáo.' },
  { title: 'Các KCN Trọng Điểm', list: 'KCN VSIP 1, VSIP 2, VSIP 3; KCN Sóng Thần 1, 2, 3; KCN Mỹ Phước 1, 2, 3; KCN Nam Tân Uyên; KCN Đồng An; KCN Việt Hương; KCN Bàu Bàng...' },
];
---

<BaseLayout
  keywords="thu mua phế liệu bình dương, thu mua cáp đồng bình dương, phế liệu kcn vsip, thanh lý nhà xưởng bình dương"
  title="Thu Mua Phế Liệu Bình Dương Giá Cao Tận Nơi | Đức Minh"
  description="Đức Minh chuyên thu mua phế liệu Bình Dương giá cao, tận nơi. Thu mua cáp đồng, nhôm, inox, sắt thép tại KCN VSIP, Sóng Thần, Mỹ Phước, Thủ Dầu Một, Dĩ An. Gọi 0936.350.118."
  canonical="https://thumuacapdonggiacao.com/thu-mua-phe-lieu-binh-duong/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Thu Mua Phế Liệu Bình Dương</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" pulsingDot class="mb-4">KHẢO SÁT 15 PHÚT TẠI CÁC KCN BÌNH DƯƠNG</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        Thu Mua Phế Liệu Bình Dương – Cáp Đồng, Nhôm, Inox Giá Cao
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Chuyên thu mua cáp đồng công trình, thanh lý xác nhà xưởng, máy móc cũ, pin năng lượng mặt trời tại các KCN VSIP, Sóng Thần, Mỹ Phước, Tân Uyên, Bến Cát... Xe cẩu bốc xếp miễn phí, thanh toán 100%!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
          <span>HOTLINE BÌNH DƯƠNG: {settings.hotlineDisplay}</span>
        </Button>
        <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
          <span>Báo Giá Zalo (5 Phút)</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-red max-w-none">
        
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          Bình Dương được mệnh danh là "thủ phủ công nghiệp" của phía Nam, với hàng loạt khu công nghiệp, nhà máy sản xuất quy mô lớn. Chính sự phát triển mạnh mẽ này đã thúc đẩy nhu cầu xử lý và thanh lý phế liệu công nghiệp trở nên cực kỳ sôi động.
        </p>
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          <strong class="text-slate-900">Công Ty Đức Minh</strong> tự hào là một trong những doanh nghiệp đi đầu trong lĩnh vực <strong>thu mua phế liệu Bình Dương</strong>. Chúng tôi chuyên thu mua phế liệu công nghiệp, cáp đồng phế liệu, máy móc nhà xưởng với giá cao nhất thị trường, cam kết mang đến giải pháp thanh lý tối ưu cho các doanh nghiệp, nhà máy tại Bình Dương.
        </p>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Các Loại Phế Liệu Chúng Tôi Thu Mua Tại Bình Dương</h2>
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Cáp đồng & Dây điện 3 pha:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Dây cáp điện lực lớn, cáp đồng nguyên chất (loại 1), dây điện bọc nhựa, đồng motor, mạt đồng.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Phế liệu sắt thép công trình:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Sắt đặc, sắt vụn xưởng cơ khí, thép hình I, H, U, V, xà gồ, hàng rào sắt dỡ bỏ nhà máy.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Phế liệu Nhôm & Inox:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Nhôm đà, nhôm Xingfa, mạt nhôm CNC. Inox 304, Inox 201 bồn chứa, ống công nghiệp xí nghiệp.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Thanh lý nhà xưởng trọn gói:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Khung kèo thép nhà xưởng cũ, máy móc lỗi thời, dây chuyền sản xuất, tủ điện công nghiệp.</span>
          </div>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Bảng Giá Thu Mua Phế Liệu Bình Dương Hôm Nay</h2>
        <p>Bảng giá tham khảo tại các KCN Bình Dương:</p>

        <!-- Table -->
        <div class="not-prose my-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-soft-sm">
          <table class="w-full text-left border-collapse bg-white text-xs sm:text-sm">
            <thead>
              <tr class="bg-slate-900 text-white font-bold">
                <th class="py-3.5 px-4 sm:px-6">Chủng Loại Phế Liệu</th>
                <th class="py-3.5 px-4 sm:px-6 text-right text-amber-400">Mức Giá Tham Khảo (VNĐ/kg)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {priceList.map((item, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-slate-900">{item.type}</td>
                  <td class="py-3.5 px-4 sm:px-6 text-right font-black text-brand-red">{item.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Các Khu Vực Thu Mua Tận Nơi Tại Tỉnh Bình Dương</h2>
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          {areas.map((a) => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
              <h3 class="font-bold text-slate-900 text-base mb-1">{a.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed font-normal">{a.list}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Lý Do Chọn Đức Minh Tại Bình Dương</h2>
        <ul class="space-y-2 text-slate-700">
          <li><strong>Không ép giá:</strong> Định giá chính xác dựa trên hàm lượng kim loại thực tế, giá mua luôn cao hơn 20-30%.</li>
          <li><strong>Thu gom siêu tốc trong ngày:</strong> Xử lý các lô hàng hàng chục tấn trong ngày, giải phóng mặt bằng nhà máy.</li>
          <li><strong>Hồ sơ pháp lý minh bạch:</strong> Có hợp đồng mua bán kinh tế, xuất hóa đơn VAT đầy đủ theo yêu cầu kế toán.</li>
          <li><strong>Thanh toán 100% tại chỗ:</strong> Chuyển khoản hoặc tiền mặt ngay khi hoàn tất cân đo bốc dỡ.</li>
          <li><strong>Dọn dẹp mặt bằng miễn phí:</strong> Đội ngũ công nhân quét dọn sạch sẽ kho bãi sau bốc hàng.</li>
        </ul>

      </div>

      <!-- Bottom High-Conversion CTA Card -->
      <div class="mt-12 bg-gradient-to-r from-brand-red to-brand-red-dark text-white rounded-3xl p-6 sm:p-8 text-center shadow-glow-red">
        <h3 class="text-2xl font-black text-white">Liên Hệ Thanh Lý Phế Liệu Bình Dương</h3>
        <p class="mt-2 text-red-100 text-sm max-w-xl mx-auto font-normal">
          Quý công ty, xí nghiệp tại Bình Dương cần dọn kho, thanh lý phế liệu công nghiệp, dây cáp điện, máy móc cũ? Hãy liên hệ ngay với Đức Minh!
        </p>
        <p class="mt-2 text-amber-300 text-xs font-bold">
          ⭐ Hoa hồng cực cao và hấp dẫn cho bộ phận mua sắm, quản lý kho hoặc cá nhân giới thiệu nguồn hàng.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={`tel:${settings.hotline}`} variant="gold" size="lg" pulse class="font-bold">
            <span>☎ Gọi Ngay: {settings.hotlineDisplay}</span>
          </Button>
          <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
            <span>💬 Chat Zalo Đức Minh</span>
          </Button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>