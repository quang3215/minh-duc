---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import FaqAccordion from '../../components/marketing/FaqAccordion.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Thu Mua Inox Phế Liệu',
    name: 'Dịch Vụ Thu Mua Inox Phế Liệu Giá Cao các loại 304, 201, 316, 430',
    description:
      'Dịch vụ thu mua phế liệu inox các loại 304, 201, 316, 430, vật tư, thiết bị inox công nghiệp giá cao tại TP.HCM và toàn quốc.',
    provider: {
      '@type': 'LocalBusiness',
      name: 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      url: 'https://thumuacapdonggiacao.com/',
      telephone: '+84936350118',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '14 ấp 2, Đông Thạnh',
        addressLocality: 'Hóc Môn',
        addressRegion: 'TP. HCM',
        addressCountry: 'VN',
      },
    },
    areaServed: {
      '@type': 'Country',
      name: 'Vietnam',
    },
    mainEntity: {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Làm thế nào để phân biệt nhanh Inox 304 và 201 tại nhà?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Cách đơn giản nhất là dùng nam châm. Inox 304 chuẩn sẽ không bị nam châm hút hoặc chỉ hút rất nhẹ. Trong khi đó, Inox 201 sẽ bị hút mạnh hơn do có nhiều tạp chất sắt. Để chắc chắn nhất, đội ngũ của chúng tôi sẽ dùng thuốc thử chuyên dụng.',
          },
        },
        {
          '@type': 'Question',
          name: 'Tại sao giá Inox 304 lại cao hơn nhiều so với Inox 201?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Giá trị của inox được quyết định bởi hàm lượng Niken và Crom. Inox 304 có hàm lượng Niken cao (trên 8%) nên có khả năng chống gỉ sét và ăn mòn vượt trội, do đó giá trị tái chế cũng cao hơn hẳn so với Inox 201 (hàm lượng Niken thấp hơn nhiều).',
          },
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Trang Chủ',
        item: 'https://thumuacapdonggiacao.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Dịch Vụ',
        item: 'https://thumuacapdonggiacao.com/dich-vu/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Thu Mua Inox',
      },
    ],
  },
]);

const inoxTypes = [
  {
    title: 'Inox Loại 1 (Inox 304, Inox 316)',
    desc: 'Tấm inox, ống hộp, bồn chứa hóa chất, thiết bị y tế và thực phẩm, giá thu mua cao nhất.',
    image: '/img/thu-mua-inox/thu-mua-inox-loai-1-304.webp',
  },
  {
    title: 'Inox Loại 2 (Inox 201)',
    desc: 'Bàn ghế, lan can, xoong chảo, đồ gia dụng inox dân dụng đã qua sử dụng thanh lý.',
    image: '/img/thu-mua-inox/thu-mua-inox-loai-2-201.webp',
  },
  {
    title: 'Inox Loại 3 (Inox 430 & Ba zớ)',
    desc: 'Phế phẩm dập cắt, mạt inox từ các xưởng cơ khí, phụ kiện bồn rửa, giá rẻ hơn.',
    image: '/img/thu-mua-inox/thu-mua-inox-loai-3-430.webp',
  },
  {
    title: 'Thiết Bị & Vật Tư Inox Cũ',
    desc: 'Bếp ăn công nghiệp, bồn rửa bát, khay kệ inox nhà hàng, khách sạn thanh lý.',
    image: '/img/thu-mua-inox/thu-mua-thiet-bi-vat-tu-inox-cu.webp',
  },
  {
    title: 'Vật Tư Inox Công Trình & Dự Án',
    desc: 'Khung inox, ống dẫn áp lực, van co tê inox từ các dự án nhà máy bia, sữa, hóa chất.',
    image: '/img/thu-mua-inox/thu-mua-vat-tu-inox-cong-trinh.webp',
  },
  {
    title: 'Ống, Hộp & Phụ Kiện Inox',
    desc: 'Cây đặc inox, thanh la, thanh V, lưới inox, phụ kiện ống hộp tồn kho công trình.',
    image: '/img/thu-mua-inox/thu-mua-ong-hop-phu-kien-inox.webp',
  },
];

const faqs = [
  {
    question: 'Làm thế nào để phân biệt nhanh Inox 304 và 201 tại nhà?',
    answer:
      'Cách đơn giản nhất là dùng nam châm: Inox 304 chuẩn sẽ không bị nam châm hút hoặc chỉ hút rất nhẹ. Inox 201 sẽ bị hút mạnh hơn do có nhiều tạp chất sắt. Để chắc chắn 100%, kỹ thuật viên của chúng tôi sẽ sử dụng thuốc thử chuyên dụng hoặc máy quang phổ phân tích hàm lượng Niken.',
  },
  {
    question: 'Tại sao giá Inox 304 lại cao hơn nhiều so với Inox 201?',
    answer:
      'Giá trị của inox được quyết định bởi hàm lượng Niken (Ni) và Crom (Cr). Inox 304 có hàm lượng Niken cao (>8%) giúp chống gỉ sét và ăn mòn vượt trội, do đó giá tái chế cao hơn 2-3 lần so với Inox 201 (chỉ chứa ~3.5-5.5% Niken).',
  },
];
---

<BaseLayout
  keywords="thu mua inox, phế liệu inox 304, giá inox 304 hôm nay, thu mua inox 201, bồn inox cũ"
  title="Thu Mua Inox Phế Liệu Giá Cao | Inox 304, 201, 316, 430 Tận Nơi"
  description="Công ty Đức Minh chuyên thu mua phế liệu inox giá cao: Inox 304, 201, 316, 430, ba zớ inox, thiết bị inox công nghiệp. Phân loại chuẩn, báo giá cao, thu mua tận nơi."
  canonical="https://thumuacapdonggiacao.com/thu-mua-inox/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <a href="/dich-vu/" class="hover:text-brand-red transition-colors">Dịch Vụ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Thu Mua Inox Phế Liệu</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" pulsingDot class="mb-4">TEST THUỐC THỬ TẠI CHỖ • GIÁ CAO NHẤT</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        Chuyên Thu Mua Phế Liệu Inox Giá Cao
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Đối tác tin cậy thu mua Inox 304, 201, 316, 430, bồn bể xí nghiệp, thiết bị bếp công nghiệp và vật tư tồn kho từ nhà xưởng, công trình. Thẩm định chuẩn xác, thanh toán 100% liền tay!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
          <span>GỌI BÁO GIÁ: {settings.hotlineDisplay}</span>
        </Button>
        <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
          <span>Báo Giá Nhanh Qua Zalo</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-soft-lg border border-slate-200">
            <img
              src="/img/thu-mua-inox/thu-mua-vat-tu-inox-cong-trinh.webp"
              alt="Thu mua vật tư inox từ công trình và dự án"
              width="600"
              height="450"
              loading="lazy"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>

        <div class="lg:col-span-7">
          <Badge variant="success" size="md" class="mb-3">ĐÚNG GIÁ TRỊ THỰC</Badge>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Bán Inox Phế Liệu Đúng Giá Trị - Tại Sao Cần Chuyên Gia?
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed font-normal">
            Inox (thép không gỉ) là loại phế liệu kim loại có giá trị kinh tế cao, nhưng giá thành lại chênh lệch rất lớn giữa các nhóm: Inox 304, 316 có giá cao gấp 2-3 lần so với Inox 201, 430. Nếu đơn vị thu mua không có máy móc test chuẩn xác, khách hàng rất dễ bị ép giá mua cào bằng.
          </p>
          <p class="mt-3 text-slate-600 text-base leading-relaxed font-normal">
            <strong class="text-slate-900">Đức Minh</strong> trang bị đầy đủ thuốc thử chuyên dụng và máy phân tích kim loại tại hiện trường. Chúng tôi cam kết phân loại chính xác từng ký inox để khách hàng nhận đúng giá trị cao nhất.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Us Grid -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <Badge variant="primary" size="md" class="mb-3">CAM KẾT DỊCH VỤ</Badge>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Lợi Ích Khi Thu Mua Inox Cùng Đức Minh
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <Card variant="default" class="p-6">
          <div class="text-3xl mb-2">🔬</div>
          <h3 class="font-bold text-slate-900 text-lg">Phân Loại Chuẩn</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-normal">
            Dùng thuốc thử và máy đo quang phổ xác định chính xác Inox 304 / 201, không lo thiệt giá.
          </p>
        </Card>

        <Card variant="default" class="p-6">
          <div class="text-3xl mb-2">💰</div>
          <h3 class="font-bold text-slate-900 text-lg">Giá Cao Theo Loại</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-normal">
            Bảng giá chi tiết niêm yết theo thị trường, cam kết giá mua Inox 304, 316 luôn dẫn đầu.
          </p>
        </Card>

        <Card variant="default" class="p-6">
          <div class="text-3xl mb-2">🚚</div>
          <h3 class="font-bold text-slate-900 text-lg">Thu Gom Nhanh</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-normal">
            Đội xe cẩu và công nhân bốc xếp tận nơi, quét dọn sạch sẽ kho bãi sau khi vận chuyển.
          </p>
        </Card>

        <Card variant="default" class="p-6">
          <div class="text-3xl mb-2">🤝</div>
          <h3 class="font-bold text-slate-900 text-lg">Hợp Tác Dài Lâu</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 font-normal">
            Hoa hồng hấp dẫn cho anh em giới thiệu và chiết khấu tốt cho hợp đồng dài hạn.
          </p>
        </Card>
      </div>

    </div>
  </section>

  <!-- Inox Types Grid -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <Badge variant="gold" size="md" class="mb-3">DANH MỤC THU MUA</Badge>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Các Loại Inox Phế Liệu Đức Minh Thu Mua
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {inoxTypes.map((item) => (
          <Card hover variant="default" class="p-0 overflow-hidden flex flex-col">
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img
                src={item.image}
                alt={item.title}
                width="600"
                height="375"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex-1 flex flex-col">
              <h3 class="font-bold text-slate-900 text-lg group-hover:text-brand-red transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 font-normal flex-1">
                {item.desc}
              </p>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <a href={settings.zaloLink} target="_blank" class="text-xs font-bold text-brand-zalo hover:underline">
                  Báo giá Zalo →
                </a>
                <a href={`tel:${settings.hotline}`} class="text-xs font-bold text-brand-phone hover:underline">
                  Gọi Hotline →
                </a>
              </div>
            </div>
          </Card>
        ))}
      </div>

    </div>
  </section>

  <!-- FAQs Accordion -->
  <FaqAccordion
    badge="HỎI ĐÁP PHẾ LIỆU INOX"
    title="Giải Đáp Về Dịch Vụ Thu Mua Inox"
    subtitle="Những câu hỏi thường gặp khi phân biệt và thanh lý Inox 304, 201, 316 và 430."
    items={faqs}
  />
</BaseLayout>