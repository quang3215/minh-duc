          <div class="bg-gradient-to-tr from-slate-900 to-slate-800 text-white rounded-3xl p-6 sm:p-8 shadow-soft-lg border border-slate-700 relative">
            <h3 class="text-xl sm:text-2xl font-black text-white">Bạn Cần Thẩm Định Giá Nhanh?</h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-300 font-normal">
              Chỉ cần chụp 2-3 tấm ảnh lô cáp đồng, pin solar hoặc phế liệu và gửi qua Zalo, kỹ sư thẩm định của chúng tôi sẽ tính toán và gửi báo giá chốt trong 5 phút!
            </p>

            <div class="mt-6 space-y-3.5">
              <div class="bg-white/10 rounded-xl p-3 flex items-center gap-3">
                <span class="text-xl">📸</span>
                <span class="text-xs sm:text-sm font-semibold text-slate-200">1. Chụp ảnh rõ nhãn mác, ruột cáp</span>
              </div>
              <div class="bg-white/10 rounded-xl p-3 flex items-center gap-3">
                <span class="text-xl">📲</span>
                <span class="text-xs sm:text-sm font-semibold text-slate-200">2. Gửi qua Zalo: 0936.350.118 (Mr. Đức)</span>
              </div>
              <div class="bg-white/10 rounded-xl p-3 flex items-center gap-3">
                <span class="text-xl">⚡</span>
                <span class="text-xs sm:text-sm font-semibold text-slate-200">3. Nhận bảng báo giá chốt cao nhất</span>
              </div>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="w-full justify-center font-bold">
                <span>Gửi Ảnh Qua Zalo Ngay</span>
              </Button>
              <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" class="w-full justify-center font-bold">
                <span>Gọi Hotline</span>
              </Button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pricing FAQs Section -->
  <FaqAccordion
    badge="HỎI ĐÁP BẢNG GIÁ"
    title="Câu Hỏi Thường Gặp Về Giá Thu Mua Phế Liệu"
