---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Chính Sách Bảo Mật | Công Ty Thu Mua Cáp Đồng Đức Minh',
  description:
    'Chính sách bảo mật của Công ty Đức Minh. Chúng tôi cam kết bảo vệ thông tin cá nhân của khách hàng khi sử dụng dịch vụ thu mua phế liệu tại TP.HCM.',
  url: 'https://thumuacapdonggiacao.com/chinh-sach-bao-mat/',
});
---

<BaseLayout
  keywords="chính sách bảo mật đức minh, bảo mật thông tin khách hàng"
  title="Chính Sách Bảo Mật | Công Ty Thu Mua Cáp Đồng Đức Minh"
  description="Chính sách bảo mật của Công ty Đức Minh. Chúng tôi cam kết bảo vệ thông tin cá nhân của khách hàng khi sử dụng dịch vụ thu mua phế liệu tại TP.HCM."
  canonical="https://thumuacapdonggiacao.com/chinh-sach-bao-mat/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Chính Sách Bảo Mật</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 bg-gradient-to-b from-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="primary" size="md" class="mb-4">QUYỀN RIÊNG TƯ & BẢO MẬT</Badge>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
        Chính Sách Bảo Mật Thông Tin
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-400 font-normal">
        Cập nhật lần cuối: Tháng 8 năm 2026 • Công Ty Thu Mua Cáp Đồng Đức Minh
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-8 text-sm text-slate-800 leading-relaxed">
        Chúng tôi tôn trọng quyền riêng tư của bạn. Chính sách này giải thích cách <strong>Công Ty Thu Mua Cáp Đồng Đức Minh</strong> thu thập, sử dụng và bảo vệ thông tin của bạn khi truy cập website <strong>thumuacapdonggiacao.com</strong>.
      </div>

      <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-red max-w-none">
        
        <h2 id="thong-tin-thu-thap" class="text-xl font-bold text-slate-900 mt-8 mb-3">1. Thông Tin Chúng Tôi Thu Thập</h2>
        <ul>
          <li><strong>Thông tin bạn cung cấp chủ động:</strong> Họ tên, số điện thoại, email, địa chỉ khi bạn liên hệ qua form báo giá, gọi Hotline hoặc nhắn Zalo.</li>
          <li><strong>Thông tin kỹ thuật tự động:</strong> Địa chỉ IP, loại trình duyệt, thiết bị, các trang đã xem, thời gian truy cập (thông qua Google Analytics và Google Tag Manager).</li>
          <li><strong>Cookie và dữ liệu theo dõi:</strong> Cookies từ Google Analytics (GA4) và Google Ads để phân tích và nâng cao trải nghiệm website.</li>
        </ul>

        <h2 id="muc-dich" class="text-xl font-bold text-slate-900 mt-8 mb-3">2. Mục Đích Sử Dụng Thông Tin</h2>
        <ul>
          <li>Liên hệ lại để tư vấn và báo giá thu mua phế liệu, cáp đồng, pin mặt trời theo yêu cầu của bạn.</li>
          <li>Cải thiện chất lượng nội dung và trải nghiệm người dùng trên website.</li>
          <li>Đo lường hiệu quả quảng cáo và tối ưu hóa dịch vụ khách hàng.</li>
          <li>Ngăn chặn các hành vi gian lận và đảm bảo an ninh hệ thống.</li>
        </ul>

        <h2 id="cookies" class="text-xl font-bold text-slate-900 mt-8 mb-3">3. Cookies và Công Nghệ Theo Dõi</h2>
        <p>
          Website chúng tôi sử dụng Google Analytics 4 (GA4) để phân tích lưu lượng truy cập. Bạn có thể kiểm soát hoặc tắt cookie trong cài đặt trình duyệt bất cứ lúc nào.
        </p>

        <h2 id="chia-se" class="text-xl font-bold text-slate-900 mt-8 mb-3">4. Chia Sẻ Thông Tin Với Bên Thứ Ba</h2>
        <p>
          Chúng tôi <strong>tuyệt đối không bán hay trao đổi</strong> thông tin cá nhân của bạn cho bất kỳ bên thứ ba nào vì mục đích thương mại. Thông tin chỉ được cung cấp khi có yêu cầu hợp pháp từ cơ quan pháp luật có thẩm quyền.
        </p>

        <h2 id="bao-mat" class="text-xl font-bold text-slate-900 mt-8 mb-3">5. Bảo Mật Thông Tin Khách Hàng</h2>
        <ul>
          <li>Toàn bộ website hoạt động trên giao thức mã hóa an toàn HTTPS (SSL/TLS 256-bit).</li>
          <li>Dữ liệu liên hệ được bảo vệ nghiêm ngặt, chỉ nhân sự có thẩm quyền mới được tiếp cận để tư vấn báo giá.</li>
          <li>Không lưu trữ bất kỳ thông tin thẻ ngân hàng hoặc thông tin thanh toán nhạy cảm nào trên website.</li>
        </ul>

        <h2 id="lien-he" class="text-xl font-bold text-slate-900 mt-8 mb-3">6. Liên Hệ Về Quyền Riêng Tư</h2>
        <div class="not-prose bg-slate-50 border border-slate-200 rounded-2xl p-5 mt-4 text-sm text-slate-800 space-y-1">
          <p><strong>Công Ty:</strong> Thu Mua Cáp Đồng Đức Minh</p>
          <p><strong>Địa chỉ:</strong> 14 ấp 2, Đông Thạnh, Hóc Môn, TP. HCM</p>
          <p><strong>Hotline / Zalo:</strong> <a href={`tel:${settings.hotline}`} class="text-brand-red font-bold">{settings.hotlineDisplay}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${settings.email}`} class="text-brand-red font-bold">{settings.email}</a></p>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>