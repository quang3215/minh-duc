---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      name: 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      image: 'https://thumuacapdonggiacao.com/img/logo.svg',
      url: 'https://thumuacapdonggiacao.com/',
      telephone: '+84936350118',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '14 ấp 2, Đông Thạnh',
        addressLocality: 'Đồng Nai',
        addressRegion: 'TP. HCM',
        addressCountry: 'VN',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang Chủ',
          item: 'https://thumuacapdonggiacao.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Thu Mua Phế Liệu Đồng Nai',
          item: 'https://thumuacapdonggiacao.com/thu-mua-phe-lieu-dong-nai/',
        },
      ],
    },
  ],
});

const priceList = [
  { type: 'Đồng cáp, đồng đỏ, cáp 3 pha công trình', price: '280.000 – 410.000 đ/kg' },
  { type: 'Sắt phế liệu, sắt vụn xưởng cơ khí, sắt công trình', price: '10.500 – 26.000 đ/kg' },
  { type: 'Nhôm phế liệu các loại (nhôm đà, nhôm định hình)', price: '45.000 – 82.000 đ/kg' },
  { type: 'Inox phế liệu (Inox 304, Inox 201, 430 bồn bể)', price: '24.000 – 75.000 đ/kg' },
  { type: 'Thanh lý máy móc thiết bị KCN, nhà xưởng', price: 'Báo giá sau khảo sát' },
];

const areas = [
  { title: 'Thành Phố & Huyện', list: 'TP. Biên Hòa, TP. Long Khánh, Huyện Long Thành, Huyện Nhơn Trạch, Huyện Trảng Bom, Huyện Vĩnh Cửu, Huyện Thống Nhất, Cẩm Mỹ, Định Quán, Xuân Lộc.' },
  { title: 'Các KCN Lớn Tại Đồng Nai', list: 'KCN Amata, KCN Biên Hòa 1 & 2, KCN Long Thành, KCN Nhơn Trạch (1, 2, 3, 4, 5, 6), KCN Tam Phước, KCN Bàu Xéo, KCN Giang Điền, KCN Hố Nai...' },
];
---

<BaseLayout
  keywords="thu mua phế liệu đồng nai, thu mua cáp đồng biên hòa, phế liệu kcn amata, phế liệu nhơn trạch, thanh lý nhà xưởng đồng nai"
  title="Thu Mua Phế Liệu Đồng Nai Giá Cao Tận Nơi | Đức Minh"
  description="Đức Minh thu mua phế liệu Đồng Nai giá cao tận nơi. Chuyên thu mua cáp đồng, sắt thép công trình, nhôm, inox tại Biên Hòa, Long Thành, Nhơn Trạch, KCN Amata. Gọi ngay 0936.350.118."
  canonical="https://thumuacapdonggiacao.com/thu-mua-phe-lieu-dong-nai/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Thu Mua Phế Liệu Đồng Nai</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" pulsingDot class="mb-4">KHẢO SÁT TẬN NƠI TẠI BIÊN HÒA, NHƠN TRẠCH, LONG THÀNH</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        Thu Mua Phế Liệu Đồng Nai – Cáp Đồng, Sắt Thép, Nhôm Giá Cao
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Đức Minh chuyên thu mua phế liệu công nghiệp, cáp đồng 3 pha, pin mặt trời, xác nhà xưởng tại các KCN Amata, Biên Hòa, Nhơn Trạch, Long Thành. Bốc xếp xe cẩu miễn phí, thanh toán 100%!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
          <span>HOTLINE ĐỒNG NAI: {settings.hotlineDisplay}</span>
        </Button>
        <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
          <span>Báo Giá Zalo (5 Phút)</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-red max-w-none">
        
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          Đồng Nai là một trong những trung tâm công nghiệp trọng điểm phía Nam với hàng chục khu công nghiệp lớn như Amata, Biên Hòa, Long Thành, Nhơn Trạch. Sự phát triển vượt bậc này tạo ra nhu cầu rất lớn về xử lý và thanh lý phế liệu công nghiệp mỗi ngày.
        </p>
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          Với hệ thống xe tải bốc xếp chuyên dụng, đội ngũ kỹ thuật lành nghề và kho bãi rộng lớn, <strong class="text-slate-900">Đức Minh</strong> cam kết mang lại giải pháp thanh lý phế liệu nhanh gọn, an toàn và tối ưu hóa lợi nhuận cho các nhà máy, xí nghiệp và các công trình tại khu vực Đồng Nai.
        </p>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Các Mặt Hàng Phế Liệu Đức Minh Thu Mua Tại Đồng Nai</h2>
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Cáp đồng & Thiết bị điện:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Dây cáp điện lực lớn, cáp ngầm, đồng thau, đồng đỏ, mô tơ cũ, máy biến áp thanh lý KCN.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Phế liệu sắt thép xây dựng:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Sắt hộp, thép hình U, I, V, H, thép cuộn, kết cấu nhà xưởng dỡ bỏ từ các công trình xây dựng.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Phế liệu Nhôm & Inox:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Nhôm đà, nhôm định hình, mạt nhôm CNC. Inox 304, Inox 201 bồn chứa và đường ống nhà máy.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Máy móc cũ & Nhà xưởng:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Thanh lý băng chuyền, máy dập, máy ép nhựa hư hỏng, hệ thống giàn giáo, cốp pha cũ.</span>
          </div>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Bảng Giá Tham Khảo Thu Mua Phế Liệu Tại Đồng Nai</h2>
        <p>Bảng giá thu mua trực tiếp tại tỉnh Đồng Nai:</p>

        <!-- Table -->
        <div class="not-prose my-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-soft-sm">
          <table class="w-full text-left border-collapse bg-white text-xs sm:text-sm">
            <thead>
              <tr class="bg-slate-900 text-white font-bold">
                <th class="py-3.5 px-4 sm:px-6">Phân Loại Phế Liệu</th>
                <th class="py-3.5 px-4 sm:px-6 text-right text-amber-400">Báo Giá Tham Khảo (VNĐ/kg)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {priceList.map((item, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-slate-900">{item.type}</td>
                  <td class="py-3.5 px-4 sm:px-6 text-right font-black text-brand-red">{item.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Các Khu Vực Thu Mua Tận Nơi Tại Tỉnh Đồng Nai</h2>
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          {areas.map((a) => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
              <h3 class="font-bold text-slate-900 text-base mb-1">{a.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed font-normal">{a.list}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Tại Sao Doanh Nghiệp Đồng Nai Chọn Đức Minh?</h2>
        <ul class="space-y-2 text-slate-700">
          <li><strong>Báo giá trung thực:</strong> Hệ thống cân điện tử chuẩn xác có tem kiểm định, định giá đúng giá trị thực tế.</li>
          <li><strong>Năng lực thu mua lớn:</strong> Khả năng thanh toán các lô hàng giá trị hàng tỷ đồng trong 1 lần chuyển khoản.</li>
          <li><strong>Trang thiết bị hiện đại:</strong> Dàn xe cẩu và máy cắt kim loại chuyên dụng giúp việc bốc xếp an toàn và nhanh gọn.</li>
          <li><strong>Hỗ trợ pháp lý đầy đủ:</strong> Xuất hóa đơn VAT, hợp đồng thu mua chuẩn pháp lý cho các công ty, tập đoàn lớn.</li>
          <li><strong>Dọn dẹp kho bãi miễn phí:</strong> Trả lại mặt bằng thông thoáng, sạch sẽ sau khi bốc hàng.</li>
        </ul>

      </div>

      <!-- Bottom High-Conversion CTA Card -->
      <div class="mt-12 bg-gradient-to-r from-brand-red to-brand-red-dark text-white rounded-3xl p-6 sm:p-8 text-center shadow-glow-red">
        <h3 class="text-2xl font-black text-white">Bạn Cần Thanh Lý Phế Liệu Tại Đồng Nai?</h3>
        <p class="mt-2 text-red-100 text-sm max-w-xl mx-auto font-normal">
          Đừng để phế liệu chiếm diện tích kho bãi và giảm giá trị theo thời gian. Hãy gọi ngay cho Đức Minh để chuyển hóa chúng thành dòng tiền mặt nhanh nhất!
        </p>
        <p class="mt-2 text-amber-300 text-xs font-bold">
          ⭐ Báo giá miễn phí 24/7 • Hoa hồng cao cho người giới thiệu.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={`tel:${settings.hotline}`} variant="gold" size="lg" pulse class="font-bold">
            <span>☎ Gọi Ngay: {settings.hotlineDisplay}</span>
          </Button>
          <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
            <span>💬 Chat Zalo Đức Minh</span>
          </Button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>