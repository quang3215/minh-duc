---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Quy Trình Thu Mua Phế Liệu Chuyên Nghiệp tại Đức Minh',
  description:
    'Quy trình thu mua phế liệu minh bạch và hiệu quả qua 5 bước, đảm bảo giá cao và thanh toán nhanh chóng cho khách hàng tại TP.HCM.',
  totalTime: 'PT1H',
  step: [
    {
      '@type': 'HowToStep',
      url: 'https://thumuacapdonggiacao.com/quy-trinh/#buoc-1',
      name: 'Bước 1: Tiếp Nhận Yêu Cầu & Tư Vấn',
      text: 'Quý khách liên hệ qua Hotline/Zalo 0936.350.118. Đội ngũ tư vấn viên sẽ thu thập thông tin sơ bộ và sắp xếp lịch hẹn khảo sát tận nơi.',
      image: 'https://thumuacapdonggiacao.com/img/quy-trinh/buoc-1-tiep-nhan-thong-tin.webp',
    },
    {
      '@type': 'HowToStep',
      url: 'https://thumuacapdonggiacao.com/quy-trinh/#buoc-2',
      name: 'Bước 2: Khảo Sát & Báo Giá Tận Nơi',
      text: 'Chuyên viên thẩm định sẽ có mặt đúng hẹn để phân loại, đánh giá chất lượng và đưa ra báo giá chi tiết, cam kết mức giá tốt nhất thị trường.',
      image: 'https://thumuacapdonggiacao.com/img/quy-trinh/buoc-2-khao-sat-bao-gia.webp',
    },
    {
      '@type': 'HowToStep',
      url: 'https://thumuacapdonggiacao.com/quy-trinh/#buoc-3',
      name: 'Bước 3: Ký Kết Hợp Đồng Giao Dịch',
      text: 'Sau khi thống nhất giá, hai bên ký kết hợp đồng thu mua với các điều khoản rõ ràng về giá cả, thời gian và phương thức thanh toán để đảm bảo tính pháp lý.',
      image: 'https://thumuacapdonggiacao.com/img/quy-trinh/buoc-3-ky-ket-hop-dong.webp',
    },
    {
      '@type': 'HowToStep',
      url: 'https://thumuacapdonggiacao.com/quy-trinh/#buoc-4',
      name: 'Bước 4: Thu Gom & Vận Chuyển',
      text: 'Đội ngũ bốc xếp chuyên nghiệp cùng xe tải chuyên dụng sẽ nhanh chóng tiến hành thu gom hàng hóa một cách an toàn, không làm ảnh hưởng đến hoạt động của khách hàng.',
      image: 'https://thumuacapdonggiacao.com/img/quy-trinh/buoc-4-thu-gom-van-chuyen.webp',
    },
    {
      '@type': 'HowToStep',
      url: 'https://thumuacapdonggiacao.com/quy-trinh/#buoc-5',
      name: 'Bước 5: Nghiệm Thu & Thanh Toán Ngay',
      text: 'Ngay sau khi toàn bộ phế liệu được chất lên xe, chúng tôi tiến hành nghiệm thu và thanh toán 100% giá trị hợp đồng ngay lập tức bằng tiền mặt hoặc chuyển khoản.',
      image: 'https://thumuacapdonggiacao.com/img/quy-trinh/buoc-5-thanh-toan-ngay.webp',
    },
  ],
});

const steps = [
  {
    id: 'buoc-1',
    num: '01',
    title: 'Tiếp Nhận Yêu Cầu & Tư Vấn Sơ Bộ',
    time: '5 Phút',
    desc: 'Quý khách liên hệ qua Hotline 0936.350.118 hoặc gửi hình ảnh qua Zalo. Đội ngũ tư vấn viên sẽ nắm bắt thông tin chủng loại, ước tính khối lượng và báo giá sơ bộ tức thì.',
    icon: '📱',
    badgeVariant: 'primary' as const,
  },
  {
    id: 'buoc-2',
    num: '02',
    title: 'Khảo Sát Hiện Trường & Chốt Giá',
    time: '15 – 30 Phút',
    desc: 'Chuyên viên thẩm định của Đức Minh có mặt trực tiếp tại công trình/kho bãi. Chúng tôi phân loại, kiểm tra tỷ lệ đồng, đo đạc khối lượng và đưa ra bảng báo giá tốt nhất.',
    icon: '🔍',
    badgeVariant: 'gold' as const,
  },
  {
    id: 'buoc-3',
    num: '03',
    title: 'Ký Kết Hợp Đồng Mua Bán Rõ Ràng',
    time: 'Trong Ngày',
    desc: 'Hai bên tiến hành ký kết hợp đồng với các điều khoản minh bạch về giá cả, khối lượng, hóa đơn VAT, thời gian bốc dỡ và cam kết bảo mật thông tin khách hàng.',
    icon: '📑',
    badgeVariant: 'success' as const,
  },
  {
    id: 'buoc-4',
    num: '04',
    title: 'Xe Cẩu Tháo Dỡ, Bốc Xếp Miễn Phí',
    time: 'Nhanh Chóng',
    desc: 'Đội ngũ công nhân lành nghề cùng hệ thống xe cẩu, xe tải chuyên dụng tự bốc xếp, vận chuyển an toàn, nhanh gọn và quét dọn mặt bằng sạch sẽ 100%.',
    icon: '🚛',
    badgeVariant: 'danger' as const,
  },
  {
    id: 'buoc-5',
    num: '05',
    title: 'Cân Đo Chuẩn Xác & Thanh Toán 100%',
    time: 'Tức Thì',
    desc: 'Tiến hành cân đo điện tử có tem kiểm định dưới sự giám sát trực tiếp của khách hàng. Thanh toán 100% bằng tiền mặt hoặc chuyển khoản trước khi xe rời bãi.',
    icon: '💵',
    badgeVariant: 'gold' as const,
  },
];
---

<BaseLayout
  keywords="quy trình thu mua phế liệu, thu mua cáp đồng, thanh lý phế liệu, công ty đức minh"
  title="Quy Trình Thu Mua Phế Liệu Chuyên Nghiệp 5 Bước tại TP.HCM | Đức Minh"
  description="Tại Đức Minh, quy trình thu mua phế liệu (đồng, nhôm, inox, cáp điện, pin mặt trời) diễn ra minh bạch qua 5 bước: Khảo sát & báo giá cao, ký hợp đồng rõ ràng, thu gom tận nơi và thanh toán 100% ngay lập tức. Đảm bảo quyền lợi khách hàng tại TP.HCM."
  canonical="https://thumuacapdonggiacao.com/quy-trinh/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Quy Trình Thu Mua</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" class="mb-4">MINH BẠCH • NHANH CHÓNG • AN TOÀN</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Quy Trình Thu Mua Phế Liệu 5 Bước Chuẩn
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Chúng tôi xây dựng quy trình làm việc khoa học, tối ưu thời gian giúp quý đối tác và doanh nghiệp giải phóng kho bãi và thu hồi vốn nhanh nhất với sự an tâm tuyệt đối.
      </p>
    </div>
  </section>

  <!-- 5 Steps Detail Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-6 sm:space-y-8">
        {steps.map((s) => (
          <div id={s.id} class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-soft-sm hover:shadow-soft-md transition-shadow relative overflow-hidden">
            <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-6">
              
              <!-- Step Icon Box -->
              <div class="w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-black text-2xl shrink-0 shadow-soft-sm">
                <span>{s.icon}</span>
              </div>

              <!-- Step Info -->
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <span class="text-xs font-black text-brand-red uppercase tracking-widest">Bước {s.num}</span>
                  <Badge variant={s.badgeVariant} size="sm">{s.time}</Badge>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight">
                  {s.title}
                </h2>
                <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
                  {s.desc}
                </p>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4 Guarantees -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <Badge variant="success" size="md" class="mb-3">CAM KẾT CỦA ĐỨC MINH</Badge>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          4 Cam Kết Vàng Khi Giao Dịch
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">⚖️</div>
          <h3 class="font-bold text-slate-900 text-base">Cân Đo Chuẩn Xác</h3>
          <p class="text-xs text-slate-600 mt-2 font-normal">Cân điện tử có kiểm định, khách hàng trực tiếp đối chiếu.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">🚛</div>
          <h3 class="font-bold text-slate-900 text-base">Xe Cẩu Miễn Phí</h3>
          <p class="text-xs text-slate-600 mt-2 font-normal">Hỗ trợ bốc xếp, tháo dỡ không tính bất kỳ chi phí phát sinh.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">💵</div>
          <h3 class="font-bold text-slate-900 text-base">Thanh Toán 100%</h3>
          <p class="text-xs text-slate-600 mt-2 font-normal">Tiền mặt hoặc chuyển khoản liền tay ngay tại công trình.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">🧹</div>
          <h3 class="font-bold text-slate-900 text-base">Dọn Dẹp Sạch Sẽ</h3>
          <p class="text-xs text-slate-600 mt-2 font-normal">Quét dọn vệ sinh trả lại mặt bằng thông thoáng sau bốc hàng.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-slate-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-black text-white">
        Sẵn Sàng Bắt Đầu Quy Trình Thu Mua?
      </h2>
      <p class="mt-3 text-slate-300 text-base max-w-2xl mx-auto font-normal">
        Chỉ cần một cuộc gọi hoặc tin nhắn Zalo, đội ngũ kỹ thuật của chúng tôi sẽ có mặt để hỗ trợ bạn ngay lập tức!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="gold" size="lg" pulse class="font-bold">
          <span>GỌI HOTLINE: {settings.hotlineDisplay}</span>
        </Button>
        <Button href="/lien-he/" variant="secondary" size="lg" class="font-bold">
          <span>Gửi Yêu Cầu Khảo Sát</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>