  },
];
---

<BaseLayout
  keywords="dịch vụ thu mua phế liệu, thu mua cáp đồng, thu mua pin mặt trời, thu mua nhôm, thu mua inox, công ty đức minh"
  title="Dịch Vụ Thu Mua Pin Mặt Trời, Cáp Đồng & Phế Liệu | Đức Minh"
  description="Công ty Đức Minh cung cấp dịch vụ thu mua chuyên nghiệp: Thu mua vật tư năng lượng mặt trời, cáp đồng, thiết bị điện, inox, nhôm, và phế liệu công nghiệp giá cao."
  canonical="https://thumuacapdonggiacao.com/dich-vu/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Dịch Vụ Thu Mua</span>
    </div>
  </nav>

  <!-- Hero Title -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge variant="gold" size="md" class="mb-4">DỊCH VỤ TOÀN DIỆN</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Dịch Vụ Thu Mua Chuyên Nghiệp Giá Cao
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-3xl mx-auto font-normal">
        Đức Minh mang đến giải pháp thu mua trọn gói: Cáp đồng, Thiết bị điện, Pin năng lượng mặt trời, Inox, Nhôm và Phế liệu công nghiệp với dịch vụ nhanh chóng, tận nơi 24/7.
      </p>
    </div>
  </section>

  <!-- Service Categories List -->
  <div class="py-16 bg-slate-50 space-y-16">
    {serviceCategories.map((cat, index) => (
      <section id={cat.id} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-slate-200 shadow-soft-sm">
          
          <!-- Category Header -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-100">
            <div>
              <div class="flex items-center gap-3">
                <Badge variant={cat.badgeVariant} size="sm">{cat.badge}</Badge>
                <span class="text-xs font-bold text-slate-400">Danh mục 0{index + 1}</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
                <a href={cat.href} class="hover:text-brand-red transition-colors">{cat.title}</a>
              </h2>
              <p class="mt-2 text-sm sm:text-base text-slate-600 max-w-3xl font-normal">
                {cat.desc}
              </p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <Button href={cat.href} variant="primary" size="md">
                <span>Xem Chi Tiết</span>
                <span slot="icon-right">→</span>
              </Button>
            </div>
          </div>

          <!-- Image Grid (6 items) -->
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
            {cat.images.map((img) => (
              <div class="group relative rounded-xl overflow-hidden bg-slate-100 aspect-square border border-slate-200">
                <img
                  src={img.src}
                  alt={img.label}
                  width="400"
                  height="400"
                  loading="lazy"
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>
                <div class="absolute bottom-2 left-2 right-2 text-white text-center">
                  <span class="text-[11px] sm:text-xs font-bold leading-tight line-clamp-2">{img.label}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>
    ))}
  </div>

  <!-- Custom Request CTA Box -->
  <section class="py-16 bg-white border-t border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge variant="danger" size="md" class="mb-3">TƯ VẤN 24/7</Badge>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
        Không Tìm Thấy Vật Tư Của Bạn?
      </h2>
      <p class="mt-3 text-base text-slate-600 max-w-2xl mx-auto font-normal">
        Ngoài các danh mục trên, chúng tôi còn thu mua rất nhiều loại vật tư, máy móc, phế liệu đặc thù khác. Hãy gửi hình ảnh trực tiếp qua Zalo để kỹ sư định giá ngay!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
          <span>GỌI HOTLINE: {settings.hotlineDisplay}</span>
        </Button>
        <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
          <span>Báo Giá Zalo (5 Phút)</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>