    id: 'nhom',
    title: 'Thu Mua Phế Liệu Nhôm Các Loại',
    href: '/thu-mua-nhom/',
    badge: 'Giá Cao Tận Nơi',
    badgeVariant: 'info' as const,
    desc: 'Chuyên thu mua nhôm đặc loại 1, nhôm thanh định hình, khung cửa Xingfa cũ, nhôm dẻo, mạt nhôm máy CNC và vật dụng nhôm công nghiệp.',
    images: [
      { src: '/img/thu-mua-nhom/thu-mua-nhom-dac-tam-loai-1.webp', label: 'Nhôm Đặc, Nhôm Tấm (Loại 1)' },
