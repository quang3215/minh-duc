      { src: '/img/thu-mua-vat-tu-nang-luong-mat-troi/thu-mua-tu-dien-phu-kien-solar.webp', label: 'Tủ Điện & Phụ Kiện Solar' },
      { src: '/img/thu-mua-vat-tu-nang-luong-mat-troi/thu-mua-khung-gian-kep-pin-solar.webp', label: 'Khung Giàn, Kẹp Pin Nhôm' },
      { src: '/img/thu-mua-vat-tu-nang-luong-mat-troi/thu-mua-cap-dien-ton-kho.webp', label: 'Vật Tư Tồn Kho Khác' },
    ],
  },
  {
    id: 'cable',
    title: 'Thu Mua Cáp Đồng & Thiết Bị Điện Công Nghiệp',
    href: '/thu-mua-cap-dong-thiet-bi-dien/',
    badge: 'Mặt Hàng Chủ Lực',
    badgeVariant: 'danger' as const,
    desc: 'Thu mua tất cả các loại cáp điện, dây dẫn Cadivi, cáp 3 pha, thiết bị đóng cắt aptomat, máy biến áp và mô tơ cũ từ các công trình và nhà máy.',
    images: [
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-cap-dien-day-dan.webp', label: 'Cáp Điện & Dây Dẫn Các Loại' },
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-tu-dien-thiet-bi-dong-cat.webp', label: 'Tủ Điện & Thiết Bị Đóng Cắt' },
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-dong-co-dien-mo-to-cu.webp', label: 'Mô Tơ & Máy Biến Áp' },
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-vat-tu-linh-kien-dien.webp', label: 'Vật Tư Linh Kiện Điện' },
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-may-moc-day-chuyen-cu.webp', label: 'Máy Móc Dây Chuyền Cũ' },
      { src: '/img/thu-mua-cap-dong-thiet-bi-dien/thanh-ly-he-thong-dien-nha-xuong.webp', label: 'Hệ Thống Điện Nhà Xưởng' },
