    images: [
      { src: '/img/thu-mua-phe-lieu-cong-nghiep/thu-mua-phe-lieu-dong.webp', label: 'Phế Liệu Đồng Các Loại' },
      { src: '/img/thu-mua-phe-lieu-cong-nghiep/thu-mua-phe-lieu-sat-thep-cong-trinh.webp', label: 'Sắt Thép Công Trình' },
