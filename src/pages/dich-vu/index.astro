---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Các Dịch Vụ Thu Mua của Công Ty Đức Minh',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        name: 'Thu Mua Vật Tư Năng Lượng Mặt Trời',
        url: 'https://thumuacapdonggiacao.com/thu-mua-pin-nang-luong-mat-troi/',
        description:
          'Thu mua các thiết bị và vật tư từ dự án điện mặt trời như tấm pin, inverter, hệ thống khung giàn, dây điện DC solar.',
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        name: 'Thu Mua Cáp Đồng & Thiết Bị Điện',
        url: 'https://thumuacapdonggiacao.com/thu-mua-cap-dong-thiet-bi-dien/',
        description:
          'Thu mua các loại cáp điện, dây dẫn, thiết bị đóng cắt, mô tơ và máy móc công nghiệp đã qua sử dụng hoặc tồn kho.',
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        name: 'Thu Mua Phế Liệu Công Nghiệp',
        url: 'https://thumuacapdonggiacao.com/thu-mua-phe-lieu-cong-nghiep/',
        description:
          'Thu mua số lượng lớn các loại phế liệu kim loại phổ biến như đồng, sắt, nhôm, inox với giá cạnh tranh.',
      },
    },
    {
      '@type': 'ListItem',
      position: 4,
      item: {
        '@type': 'Service',
        name: 'Thu Mua Inox',
        url: 'https://thumuacapdonggiacao.com/thu-mua-inox/',
        description:
          'Thu mua mọi loại inox phế liệu, từ Inox 304, 316 đến 201, 430 và các loại vật tư, thiết bị inox công nghiệp cũ.',
      },
    },
    {
      '@type': 'ListItem',
      position: 5,
      item: {
        '@type': 'Service',
        name: 'Thu Mua Nhôm',
        url: 'https://thumuacapdonggiacao.com/thu-mua-nhom/',
        description:
          'Chuyên thu mua phế liệu nhôm đa dạng, bao gồm nhôm đặc, hợp kim, vụn nhôm, cửa nhôm cũ và các vật dụng bằng nhôm khác.',
      },
    },
  ],
});

const serviceCategories = [
  {
    id: 'solar',
    title: 'Thu Mua Vật Tư Năng Lượng Mặt Trời',
    href: '/thu-mua-pin-nang-luong-mat-troi/',
    badge: 'Chuyên Nghiệp Hàng Đầu',
    badgeVariant: 'gold' as const,
    desc: 'Thu hồi trọn gói các thiết bị và vật tư từ dự án điện mặt trời: tấm pin Mono/Poly, biến tần inverter, hệ thống khung giàn ray nhôm và dây cáp điện DC Solar.',
    images: [
      { src: '/img/thu-mua-vat-tu-nang-luong-mat-troi/thu-mua-pin-nang-luong-mat-troi.webp', label: 'Tấm Pin Năng Lượng Mặt Trời' },
      { src: '/img/thu-mua-vat-tu-nang-luong-mat-troi/thu-mua-phe-lieu-cong-trinh-solar.webp', label: 'Phế Liệu Công Trình NLMT' },
