      { src: '/img/thu-mua-phe-lieu-cong-nghiep/thu-mua-phe-lieu-inox.webp', label: 'Phế Liệu Inox 304, 201' },
      { src: '/img/thu-mua-phe-lieu-cong-nghiep/thu-mua-phe-lieu-hop-kim-gang-thiec.webp', label: 'Hợp Kim, Gang, Thiếc' },
      { src: '/img/thu-mua-phe-lieu-cong-nghiep/thu-mua-phe-lieu-may-moc-cu.webp', label: 'Phế Liệu Từ Máy Móc Cũ' },
    ],
  },
  {
    id: 'inox',
    title: 'Thu Mua Phế Liệu Inox (Thép Không Gỉ)',
    href: '/thu-mua-inox/',
    badge: 'Phân Loại Chuẩn',
    badgeVariant: 'success' as const,
    desc: 'Thu mua mọi loại inox phế liệu từ Inox 304, Inox 316 đến Inox 201, 430, bồn chứa, ống hộp và thiết bị inox công nghiệp thanh lý.',
    images: [
      { src: '/img/thu-mua-inox/thu-mua-inox-loai-1-304.webp', label: 'Inox Loại 1 (304, 316)' },
      { src: '/img/thu-mua-inox/thu-mua-inox-loai-2-201.webp', label: 'Inox Loại 2 (201)' },
      { src: '/img/thu-mua-inox/thu-mua-inox-loai-3-430.webp', label: 'Inox Loại 3 (430, ba zớ)' },
      { src: '/img/thu-mua-inox/thu-mua-thiet-bi-vat-tu-inox-cu.webp', label: 'Thiết Bị & Bồn Inox Cũ' },
