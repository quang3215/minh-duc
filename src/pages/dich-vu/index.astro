      { src: '/img/thu-mua-nhom/thu-mua-la-phong-tan-nhiet-nhom.webp', label: 'La Phông, Tản Nhiệt Nhôm' },
      { src: '/img/thu-mua-nhom/thu-mua-thang-nhom-do-dung-nhom.webp', label: 'Thang Nhôm & Đồ Dùng Nhôm' },
