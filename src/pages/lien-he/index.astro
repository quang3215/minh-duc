---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Liên Hệ Công Ty Thu Mua Cáp Đồng Đức Minh',
  description:
    'Thông tin liên hệ chính thức của Công ty Đức Minh để yêu cầu báo giá và dịch vụ thu mua phế liệu tận nơi tại TP.HCM và các tỉnh lân cận.',
  url: 'https://thumuacapdonggiacao.com/lien-he/',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: 'Công Ty Thu Mua Cáp Đồng Đức Minh',
    image: 'https://thumuacapdonggiacao.com/img/logo.svg',
    url: 'https://thumuacapdonggiacao.com/',
    telephone: '+84936350118',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '14 ấp 2, Đông Thạnh',
      addressLocality: 'Hóc Môn',
      addressRegion: 'TP. HCM',
      addressCountry: 'VN',
    },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '06:00',
      closes: '22:00',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+84-936-350-118',
      contactType: 'customer service',
      areaServed: 'VN',
      availableLanguage: 'Vietnamese',
    },
  },
});
---

<BaseLayout
  keywords="liên hệ đức minh, hotline thu mua cáp đồng, địa chỉ thu mua phế liệu hóc môn, báo giá phế liệu tận nơi"
  title="Liên Hệ Đức Minh [0936.350.118] - Báo Giá Thu Mua Phế Liệu Cao Nhất"
  description="Gọi ngay 0936.350.118 (Zalo) để nhận báo giá thu mua phế liệu đồng, nhôm, inox, cáp điện, pin mặt trời... giá cao nhất TP.HCM. Công ty Đức Minh cam kết khảo sát tận nơi miễn phí, thu mua nhanh chóng, thanh toán liền tay."
  canonical="https://thumuacapdonggiacao.com/lien-he/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Liên Hệ</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" pulsingDot class="mb-4">HỖ TRỢ 24/7 TOÀN QUỐC</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Kết Nối Trực Tiếp Với Đức Minh
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn 24/7. Hãy gọi ngay Hotline hoặc gửi thông tin để nhận báo giá tốt nhất trong 5 phút!
      </p>
    </div>
  </section>

  <!-- Main Contact Grid -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        
        <!-- Left: Direct Info Cards -->
        <div class="lg:col-span-6 space-y-6">
          <div>
            <Badge variant="danger" size="sm" class="mb-2">THÔNG TIN LIÊN HỆ</Badge>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
              Công Ty Thu Mua Cáp Đồng Đức Minh
            </h2>
            <p class="mt-2 text-slate-600 text-sm sm:text-base font-normal">
              Đội ngũ khảo sát và xe cẩu luôn sẵn sàng phục vụ quý khách tại TP.HCM, Bình Dương, Đồng Nai và khắp các tỉnh thành.
            </p>
          </div>

          <!-- Contact items list -->
          <div class="space-y-4">
            
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-soft-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-red-100 text-brand-red flex items-center justify-center text-xl shrink-0">
                📍
              </div>
              <div>
                <strong class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Trụ sở chính</strong>
                <p class="text-base font-bold text-slate-900 mt-0.5">14 ấp 2, Đông Thạnh, Hóc Môn, TP. Hồ Chí Minh</p>
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-soft-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-amber-100 text-brand-gold flex items-center justify-center text-xl shrink-0">
                📞
              </div>
              <div>
                <strong class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Hotline / Zalo (Mr. Đức)</strong>
                <a href={`tel:${settings.hotline}`} class="text-xl font-black text-brand-phone hover:underline mt-0.5 block">
                  {settings.hotlineDisplay}
                </a>
                <span class="text-xs text-slate-500">Tư vấn báo giá nhanh chóng trong 5 phút</span>
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-soft-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-100 text-brand-zalo flex items-center justify-center text-xl shrink-0">
                ✉️
              </div>
              <div>
                <strong class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Email liên hệ báo giá</strong>
                <a href={`mailto:${settings.email}`} class="text-base font-bold text-slate-900 hover:text-brand-red mt-0.5 block">
                  {settings.email}
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-soft-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl shrink-0">
                ⏰
              </div>
              <div>
                <strong class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Thời gian làm việc</strong>
                <p class="text-base font-bold text-slate-900 mt-0.5">06:00 - 22:00 (Tất cả các ngày trong tuần & Ngày lễ)</p>
              </div>
            </div>

          </div>

          <!-- Quick Buttons -->
          <div class="flex flex-wrap gap-4 pt-2">
            <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
              <span>Gọi Hotline Ngay</span>
            </Button>
            <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
              <span>Chat Zalo Với Đức Minh</span>
            </Button>
          </div>
        </div>

        <!-- Right: Inquiry Form Card -->
        <div class="lg:col-span-6">
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-soft-md">
            <Badge variant="gold" size="sm" class="mb-2">GỬI YÊU CẦU NHANH</Badge>
            <h3 class="text-2xl font-black text-slate-900">Yêu Cầu Khảo Sát & Báo Giá</h3>
            <p class="mt-1 text-slate-600 text-sm font-normal">
              Điền thông tin bên dưới, chuyên viên Đức Minh sẽ liên hệ lại quý khách trong 5 phút.
            </p>

            <form
              action="https://formspree.io/f/movpayap"
              method="POST"
              class="mt-6 space-y-4"
            >
              <div>
                <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                  Họ và tên của bạn <span class="text-brand-red">*</span>
                </label>
                <input
                  id="name"
                  type="text"
                  name="name"
                  required
                  placeholder="Ví dụ: Anh Hùng (Kỹ sư MEP)"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent text-sm"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                  Số điện thoại / Zalo <span class="text-brand-red">*</span>
                </label>
                <input
                  id="phone"
                  type="tel"
                  name="phone"
                  required
                  placeholder="Ví dụ: 0912.xxx.xxx"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent text-sm"
                />
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                  Mô tả vật tư cần thanh lý <span class="text-brand-red">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Ví dụ: Cần bán 2 tấn cáp đồng Cadivi tại KCN VSIP 1 Bình Dương..."
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-transparent text-sm"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-3.5 px-6 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-black text-base shadow-glow-red transition-all transform hover:-translate-y-0.5"
              >
                Gửi Yêu Cầu Báo Giá Ngay →
              </button>

              <p class="text-[11px] text-slate-500 text-center mt-2">
                🔒 Cam kết bảo mật thông tin 100% • Không spam • Phản hồi sau 5 phút
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Google Map Section -->
  <section class="w-full bg-slate-100 border-t border-slate-200">
    <div class="w-full h-[450px]">
      <iframe
        title="Bản đồ chỉ đường đến Công ty Đức Minh"
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15670.804260691722!2d106.636344!3d10.910308!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d70677247829%3A0xab4886d2a9b58705!2zQ8OUTkcgVFkgVEhVIE1VQSBQSOG6viBMSeG7hlUgxJDhu6hDIE1JTkg!5e0!3m2!1svi!2sus!4v1761935511970!5m2!1svi!2sus"
        class="w-full h-full border-0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>
</BaseLayout>