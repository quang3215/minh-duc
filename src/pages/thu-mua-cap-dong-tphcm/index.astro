---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import settings from '../../data/settings.json';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      name: 'Công Ty Thu Mua Cáp Đồng Đức Minh',
      image: 'https://thumuacapdonggiacao.com/img/logo.svg',
      url: 'https://thumuacapdonggiacao.com/',
      telephone: '+84936350118',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '14 ấp 2, Đông Thạnh',
        addressLocality: 'Hồ Chí Minh',
        addressRegion: 'TP. HCM',
        addressCountry: 'VN',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Trang Chủ',
          item: 'https://thumuacapdonggiacao.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Thu Mua Cáp Đồng TP.HCM',
          item: 'https://thumuacapdonggiacao.com/thu-mua-cap-dong-tphcm/',
        },
      ],
    },
  ],
});

const priceList = [
  { type: 'Đồng cáp loại 1 (Đồng đỏ đặc, cáp điện lực lớn, Cadivi)', price: '285.000 – 410.000 đ/kg' },
  { type: 'Đồng loại 2 (Đồng dây điện lõi nhỏ, đồng ruột mô tơ)', price: '255.000 – 325.000 đ/kg' },
  { type: 'Đồng vàng (Đồng thau, ống đồng, van khóa)', price: '175.000 – 250.000 đ/kg' },
  { type: 'Đồng vụn, mạt đồng tiện phay cơ khí', price: '165.000 – 225.000 đ/kg' },
  { type: 'Dây cáp nhôm, cáp điện lực các loại', price: 'Liên hệ có giá tốt nhất' },
];

const areas = [
  { title: 'Khu Vực Trung Tâm', list: 'Quận 1, Quận 3, Quận 4, Quận 5, Quận 6, Quận 8, Quận 10, Quận 11, Phú Nhuận, Bình Thạnh, Gò Vấp, Tân Bình, Tân Phú.' },
  { title: 'Khu Vực Phía Đông (TP. Thủ Đức)', list: 'Quận 2, Quận 9, Thủ Đức, Khu Công Nghệ Cao (SHTP), Cát Lái, Tam Bình, Linh Trung.' },
  { title: 'Khu Vực Phía Tây & Nam', list: 'Quận 7, Quận 12, Bình Tân, Huyện Bình Chánh, Huyện Nhà Bè, Huyện Hóc Môn, Huyện Củ Chi, Cần Giờ.' },
  { title: 'Các KCN Trọng Điểm', list: 'KCN Tân Bình, KCN Vĩnh Lộc, KCN Tân Tạo, KCN Lê Minh Xuân, KCN Hiệp Phước, KCN Linh Trung 1 & 2...' },
];
---

<BaseLayout
  keywords="thu mua cáp đồng tphcm, thu mua phế liệu hcm, thu mua dây điện cũ tphcm, giá đồng cáp tphcm"
  title="Thu Mua Cáp Đồng TP.HCM Giá Cao Tận Nơi | Đức Minh"
  description="Đức Minh chuyên thu mua cáp đồng TP.HCM giá cao, tận nơi 24/7. Thu mua đồng đỏ, đồng cáp, đồng vàng tại Hóc Môn, Bình Chánh, Thủ Đức, Quận 12... Gọi ngay 0936.350.118."
  canonical="https://thumuacapdonggiacao.com/thu-mua-cap-dong-tphcm/"
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="bg-slate-100 border-b border-slate-200 py-3 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-slate-500">
      <a href="/" class="hover:text-brand-red transition-colors">Trang Chủ</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Thu Mua Cáp Đồng TP.HCM</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 lg:py-16 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <Badge variant="gold" size="md" pulsingDot class="mb-4">CÓ MẶT SAU 15-30 PHÚT TẠI TẤT CẢ QUẬN HUYỆN TP.HCM</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        Thu Mua Cáp Đồng TP.HCM Giá Cao Nhất
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
        Công ty Đức Minh chuyên thu mua tận nơi 24/7 dây điện 3 pha, cáp đồng công trình, motor cũ, máy biến áp và phế liệu nhà xưởng tại TP.HCM. Cân điện tử chuẩn xác, thanh toán 100% tại chỗ!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`tel:${settings.hotline}`} variant="phone" size="lg" pulse class="font-bold">
          <span>HOTLINE TP.HCM: {settings.hotlineDisplay}</span>
        </Button>
        <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
          <span>Báo Giá Zalo (5 Phút)</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-red max-w-none">
        
        <p class="text-base sm:text-lg leading-relaxed text-slate-700">
          Thành phố Hồ Chí Minh là trung tâm kinh tế lớn nhất cả nước, nơi tập trung hàng ngàn nhà máy, xí nghiệp, khu công nghiệp và các dự án xây dựng hạ tầng quy mô lớn. Kéo theo đó là nhu cầu thanh lý phế liệu, đặc biệt là <strong>cáp đồng, dây điện cũ, phế liệu công trình</strong> ngày càng tăng cao. Nắm bắt được nhu cầu này, Công Ty Đức Minh ra đời với sứ mệnh mang đến dịch vụ <strong>thu mua cáp đồng TP.HCM</strong> uy tín, chuyên nghiệp và với mức giá cạnh tranh nhất trên thị trường.
        </p>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Các Loại Phế Liệu Cáp Đồng Chúng Tôi Thu Mua Tại TP.HCM</h2>
        <p>Đồng là một trong những kim loại có giá trị kinh tế cao và khả năng tái chế lên đến 100%. Đức Minh nhận thu mua đa dạng các loại cáp đồng, đồng phế liệu bao gồm:</p>
        
        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Đồng cáp loại 1 (Đồng đặc):</strong>
            <span class="text-xs text-slate-600 mt-1 block">Cáp đồng nguyên chất, dây đồng đỏ trần, cáp điện lực Cadivi ruột lớn, cáp trung thế không vỏ.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Đồng cáp loại 2 (Đồng sợi nhỏ):</strong>
            <span class="text-xs text-slate-600 mt-1 block">Dây điện dân dụng, dây cáp điện lõi nhỏ có vỏ bọc, ruột mô tơ, máy biến áp.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Đồng vàng (Đồng thau):</strong>
            <span class="text-xs text-slate-600 mt-1 block">Chi tiết máy móc, ống đồng điều hòa, vòi sen, khóa cửa, đồ gia dụng bằng đồng thau.</span>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
            <strong class="text-brand-red text-sm block">Đồng vụn & Mạt đồng:</strong>
            <span class="text-xs text-slate-600 mt-1 block">Phế phẩm từ quá trình gia công cơ khí tiện phay CNC, đồng cháy công trình.</span>
          </div>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Bảng Giá Thu Mua Cáp Đồng TP.HCM Hôm Nay</h2>
        <p>Bảng giá tham khảo tại TP.HCM được cập nhật liên tục. Để nhận giá chốt tốt nhất theo từng lô hàng, quý khách vui lòng liên hệ trực tiếp <strong>Hotline: 0936.350.118</strong>.</p>
        
        <!-- Table -->
        <div class="not-prose my-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-soft-sm">
          <table class="w-full text-left border-collapse bg-white text-xs sm:text-sm">
            <thead>
              <tr class="bg-slate-900 text-white font-bold">
                <th class="py-3.5 px-4 sm:px-6">Chủng Loại Phế Liệu Đồng</th>
                <th class="py-3.5 px-4 sm:px-6 text-right text-amber-400">Đơn Giá Hôm Nay (VNĐ/kg)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {priceList.map((item, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-slate-900">{item.type}</td>
                  <td class="py-3.5 px-4 sm:px-6 text-right font-black text-brand-red">{item.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Khu Vực Thu Mua Phế Liệu Tận Nơi Tại TP.HCM</h2>
        <p>Với hệ thống xe tải và xe cẩu cơ động, Đức Minh có mặt khảo sát tận nơi tại tất cả quận huyện TP.HCM chỉ sau 15-30 phút:</p>

        <div class="grid sm:grid-cols-2 gap-4 not-prose my-6">
          {areas.map((a) => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
              <h3 class="font-bold text-slate-900 text-base mb-1">{a.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed font-normal">{a.list}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl font-black text-slate-900 mt-10 mb-4">Tại Sao Nên Chọn Đức Minh Tại TP.HCM?</h2>
        <ul class="space-y-2 text-slate-700">
          <li><strong>Báo giá nhanh - Giá cao hơn 20-30%:</strong> Thu mua trực tiếp không qua trung gian.</li>
          <li><strong>Cân đo điện tử minh bạch:</strong> Có tem kiểm định đo lường, đối chiếu trực tiếp.</li>
          <li><strong>Thanh toán 100% tại chỗ:</strong> Nhận tiền mặt hoặc chuyển khoản ngay khi bốc hàng lên xe.</li>
          <li><strong>Xe cẩu bốc dỡ miễn phí 100%:</strong> Không phát sinh chi phí tháo dỡ hay nhân công.</li>
          <li><strong>Đầy đủ hồ sơ năng lực & hóa đơn VAT:</strong> Hợp đồng kinh tế rõ ràng, hợp pháp.</li>
        </ul>

      </div>

      <!-- Bottom High-Conversion CTA Card -->
      <div class="mt-12 bg-gradient-to-r from-brand-red to-brand-red-dark text-white rounded-3xl p-6 sm:p-8 text-center shadow-glow-red">
        <h3 class="text-2xl font-black text-white">Cần Bán Cáp Đồng & Phế Liệu Tại TP.HCM?</h3>
        <p class="mt-2 text-red-100 text-sm max-w-xl mx-auto font-normal">
          Hãy liên hệ ngay hôm nay để được khảo sát tận nơi miễn phí và nhận mức giá thu mua cao nhất TP.HCM!
        </p>
        <p class="mt-2 text-amber-300 text-xs font-bold">
          ⭐ Hoa hồng cực cao cho anh em kỹ sư, thủ kho, người giới thiệu nguồn hàng.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={`tel:${settings.hotline}`} variant="gold" size="lg" pulse class="font-bold">
            <span>☎ Gọi Ngay: {settings.hotlineDisplay}</span>
          </Button>
          <Button href={settings.zaloLink} target="_blank" variant="zalo" size="lg" class="font-bold">
            <span>💬 Chat Zalo (Mr. Đức)</span>
          </Button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>