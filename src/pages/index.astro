---

<BaseLayout
  keywords="thu mua cáp đồng, thu mua phế liệu, giá cao, công ty đức minh, phế liệu đồng, thanh lý cáp đồng, pin mặt trời cũ"
  title="Thu Mua Cáp Đồng Giá Cao Tận Nơi | Công Ty Đức Minh"
  description="Đức Minh thu mua cáp đồng, pin năng lượng mặt trời, phế liệu điện giá cao tận nơi TP.HCM. Thanh toán ngay, uy tín 10+ năm!"
  canonical="https://thumuacapdonggiacao.com/"
  schema={schema}
>
  <!-- Hero Section -->
  <HeroHighConversion />

  <!-- About Snapshot Section -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Image with Overlays -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-soft-lg border border-slate-200 group">
            <img
              src="/img/gioi-thieu-cong-ty-thu-mua-cap-dong-duc-minh.webp"
              alt="Giới thiệu Công Ty Thu Mua Cáp Đồng Đức Minh"
              width="600"
              height="500"
              loading="lazy"
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-soft-md border border-slate-100">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Kinh nghiệm thực tế</p>
                  <p class="text-lg font-black text-brand-red">Hơn 10 Năm Phục Vụ</p>
                </div>
                <Badge variant="gold" size="md">Đối Tác Hàng Đầu</Badge>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Content -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <Badge variant="danger" size="md" class="mb-3">VỀ ĐỨC MINH</Badge>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Đơn Vị Thu Mua Cáp Đồng & Vật Tư Điện Uy Tín Hàng Đầu
          </h2>
          <p class="mt-4 text-base text-slate-600 leading-relaxed font-normal">
            <strong class="text-slate-900">ĐỨC MINH</strong> là đơn vị tiên phong và uy tín hàng đầu trong lĩnh vực thu mua cáp đồng, dây điện cũ, pin năng lượng mặt trời và các loại vật tư, thiết bị điện công nghiệp, phế liệu tồn kho từ các công trình, dự án, nhà xưởng và khu công nghiệp tại TP.HCM, Bình Dương, Đồng Nai và toàn quốc.
          </p>
          <p class="mt-3 text-base text-slate-600 leading-relaxed font-normal">
            Với năng lực tài chính vững mạnh và đội xe cẩu chuyên dụng, chúng tôi cam kết thu mua trực tiếp không qua trung gian, định giá cao hơn 20-30% thị trường, hỗ trợ bốc xếp miễn phí và thanh toán 100% liền tay.
          </p>

          <!-- Highlights Grid -->
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full">
            <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">✓</span>
              <span class="text-sm font-semibold text-slate-800">Thu mua tận nơi 24/7, không ngại xa</span>
            </div>
            <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">✓</span>
              <span class="text-sm font-semibold text-slate-800">Đội xe cẩu & bốc xếp miễn phí 100%</span>
            </div>
            <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">✓</span>
              <span class="text-sm font-semibold text-slate-800">Cân đo điện tử chuẩn xác, minh bạch</span>
            </div>
            <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">✓</span>
              <span class="text-sm font-semibold text-slate-800">Hoa hồng hấp dẫn cho người giới thiệu</span>
            </div>
          </div>

          <!-- Dual Buttons -->
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button href="/gioi-thieu/" variant="primary" size="md">
              <span>Tìm Hiểu Về Chúng Tôi</span>
              <svg slot="icon-right" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </Button>
            <Button href={`tel:${settings.hotline}`} variant="phone" size="md">
              <span>Hotline: {settings.hotlineDisplay}</span>
            </Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Services Grid Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <Badge variant="danger" size="md" class="mb-3">DANH MỤC THU MUA</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Dịch Vụ Thu Mua Chuyên Nghiệp Giá Cao
        </h2>
        <p class="mt-3 text-base sm:text-lg text-slate-600 font-normal">
          Đức Minh thu mua toàn diện các loại kim loại màu, cáp đồng, pin solar và phế liệu công nghiệp với mức giá cao nhất thị trường.
        </p>
      </div>

      <!-- 6 Service Cards Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {services.map((srv) => (
          <Card hover variant="default" class="flex flex-col h-full overflow-hidden p-0">
            <!-- Thumbnail Image -->
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img
                src={srv.image}
                alt={srv.title}
                width="600"
                height="375"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 right-3">
                <Badge variant={srv.badgeVariant} size="sm">
                  {srv.badge}
                </Badge>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-5 sm:p-6 flex flex-col flex-1">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-brand-red transition-colors">
                <a href={srv.href}>{srv.title}</a>
              </h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed font-normal">
                {srv.subtitle}
              </p>

              <!-- Highlights -->
              <ul class="mt-4 space-y-1.5 border-t border-slate-100 pt-3 flex-1">
                {srv.highlights.map((h) => (
                  <li class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
                    <span class="text-emerald-600 font-bold">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <!-- Bottom CTA -->
              <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={srv.href}
                  class="text-xs sm:text-sm font-bold text-brand-red hover:text-brand-red-dark flex items-center gap-1 group/link"
                >
                  <span>Xem Chi Tiết</span>
                  <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                </a>
                <a
                  href={`tel:${settings.hotline}`}
                  class="text-xs font-bold text-slate-600 hover:text-brand-phone flex items-center gap-1"
                >
                  <span>Báo giá: {settings.hotlineDisplay}</span>
                </a>
              </div>
            </div>
          </Card>
        ))}
      </div>

      <!-- View All Services CTA -->
      <div class="mt-12 text-center">
        <Button href="/dich-vu/" variant="secondary" size="lg">
          <span>Xem Tất Cả Dịch Vụ Thu Mua</span>
          <svg slot="icon-right" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </Button>
      </div>

    </div>
  </section>

  <!-- 6 Golden Commitments / Features Grid -->
  <FeaturesGrid />

  <!-- Live Pricing Table Section -->
  <PricingTable />

  <!-- Real Project Photos Gallery -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <Badge variant="gold" size="md" class="mb-3">MINH CHỨNG NĂNG LỰC</Badge>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Hình Ảnh Thu Mua & Bốc Xếp Thực Tế
        </h2>
        <p class="mt-3 text-base sm:text-lg text-slate-600 font-normal">
          Minh chứng cho năng lực, phương tiện xe cẩu hiện đại và sự chuyên nghiệp của Đức Minh qua các công trình, dự án lớn đã thực hiện.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 lg:gap-6">
        {galleryImages.map((img) => (
          <div class="group relative rounded-2xl overflow-hidden shadow-soft-sm bg-slate-100 aspect-[4/3] border border-slate-200">
            <img
              src={img.src}
              alt={img.alt}
              width="600"
              height="450"
              loading="lazy"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <span class="text-xs sm:text-sm font-bold block leading-tight">{img.title}</span>
              <span class="text-[11px] text-amber-300 font-medium hidden sm:inline-block">Đức Minh 24/7</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4-Step Process Flow -->
  <ProcessFlow />

  <!-- Social Proof & Customer Reviews -->
  <SocialProofTestimonials />

  <!-- Latest News / Articles Preview Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <Badge variant="primary" size="md" class="mb-3">TIN TỨC & KINH NGHIỆM</Badge>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Bài Viết Mới Nhất & Cập Nhật Thị Trường
          </h2>
          <p class="mt-2 text-base text-slate-600 font-normal max-w-2xl">
            Cập nhật biến động giá kim loại, hướng dẫn phân loại cáp đồng và mẹo tối ưu hóa giá trị thanh lý phế liệu.
          </p>
        </div>
        <Button href="/tin-tuc/" variant="secondary" size="md" class="self-start sm:self-auto shrink-0">
          <span>Xem Tất Cả Bài Viết</span>
          <span slot="icon-right">→</span>
        </Button>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {latestPosts.map((post) => (
          <Card hover variant="default" class="flex flex-col h-full overflow-hidden p-0">
            <a href={`/tin-tuc/${post.slug}/`} class="relative aspect-[16/10] overflow-hidden bg-slate-100 block group/img">
              <img
                src={post.data.image || '/img/thu-mua-cap-dong-thiet-bi-dien/thu-mua-cap-dien-day-dan.webp'}
                alt={post.data.imageAlt || post.data.title}
                width="600"
                height="375"
                loading="lazy"
                class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3">
                <Badge variant="gold" size="sm">
                  {post.data.tags?.[0] || 'Kinh Nghiệm'}
                </Badge>
              </div>
            </a>
            
            <div class="p-5 sm:p-6 flex flex-col flex-1">
              <div class="text-xs text-slate-500 mb-2 font-medium">
                {new Date(post.data.pubDate).toLocaleDateString('vi-VN', {
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric',
                })}
              </div>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-brand-red transition-colors line-clamp-2">
                <a href={`/tin-tuc/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed flex-1 font-normal">
                {post.data.description}
              </p>
              <div class="mt-4 pt-3 border-t border-slate-100">
                <a
                  href={`/tin-tuc/${post.slug}/`}
                  class="text-xs sm:text-sm font-bold text-brand-red hover:text-brand-red-dark flex items-center gap-1"
                >
                  <span>Đọc tiếp</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </Card>
        ))}
      </div>

    </div>
  </section>

  <!-- Interactive FAQ Accordion -->
  <FaqAccordion
    badge="HỎI ĐÁP PHỔ BIẾN"
    title="Giải Đáp Thắc Mắc Về Dịch Vụ Thu Mua"
    subtitle="Những câu hỏi thường gặp nhất của quý khách hàng và nhà thầu khi thanh lý cáp đồng, pin solar và phế liệu."
    items={homeFaqs}
  />

  <!-- Final High-Conversion Urgency CTA Banner -->
  <section class="py-14 bg-gradient-to-r from-brand-red via-red-700 to-brand-red-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white">
        Bạn Cần Thanh Lý Cáp Đồng & Phế Liệu Hôm Nay?
      </h2>
      <p class="mt-3 text-base sm:text-lg text-red-100 max-w-2xl mx-auto font-normal">
        Liên hệ ngay Hotline hoặc gửi ảnh qua Zalo để nhận báo giá cao nhất trong 5 phút. Xe cẩu và nhân viên có mặt sau 15-30 phút!
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          href={`tel:${settings.hotline}`}
          variant="gold"
          size="lg"
          pulse
          class="font-black text-base shadow-glow-gold"
        >
          <svg slot="icon-left" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
          </svg>
          <span>GỌI HOTLINE: {settings.hotlineDisplay}</span>
        </Button>
        <Button
          href={settings.zaloLink}
          target="_blank"
          variant="zalo"
          size="lg"
          class="font-bold text-base"
        >
          <span>Báo Giá Nhanh Zalo (5 Phút)</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>